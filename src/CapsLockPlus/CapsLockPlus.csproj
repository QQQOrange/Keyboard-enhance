<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KeyboardEnhance</AssemblyName>
    <RootNamespace>CapsLockPlus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>3.9.0</Version>
    <FileVersion>3.9.0.0</FileVersion>
    <AssemblyVersion>3.9.0.0</AssemblyVersion>
    <Product>按键增强 Keyboard Enhance</Product>
    <Company>QQQOrange</Company>
    <Description>键盘增强工具：任意键绑定功能、光标移动与选择、快速搜索面板、窗口绑定、直达网页、独立剪贴板、宏与多图层</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>

    <!-- WPF 启动开销控制：去掉不需要的语言资源与调试符号，缩短首屏时间 -->
    <PublishTrimmed>false</PublishTrimmed>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- 性能与体积：ReadyToRun 让启动时少做 JIT；压缩单文件减小体积 -->
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 应用图标（512×512 PNG）。界面里的品牌区统一用它，
         不再用 Segoe 图标字体的 glyph —— 那和 exe 上的图标完全是两回事，
         用户一眼就看出"里面这个图标跟外面那个不一样"。 -->
    <Resource Include="Assets\app.png" />
    <!-- 内置引擎图标（由 QuickSearch 的图标库转换而来，见 tools/qs_gen.py）。
         以 Resource 形式打包进程序，运行时不依赖磁盘或网络。 -->
    <Resource Include="Assets\engine-icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation：直接读取选区，不受 UIPI 限制 -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.16299.0" />
    <!-- WMI：调屏幕亮度（root\wmi） -->
    <PackageReference Include="System.Management" Version="10.0.13" />
    <!-- DPAPI（ProtectedData）在 net10.0-windows 目标框架里已自带，无需额外引用 -->
  </ItemGroup>

</Project>
