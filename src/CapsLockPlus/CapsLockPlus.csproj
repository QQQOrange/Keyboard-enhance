<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CapsLockPlus</AssemblyName>
    <RootNamespace>CapsLockPlus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.6.3</Version>
    <FileVersion>1.6.3.0</FileVersion>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
    <Product>CapsLock+（QQQOrange）</Product>
    <Company>QQQOrange</Company>
    <Description>CapsLock 键增强：光标移动 / 选择、Qbar 快速启动、窗口绑定、独立剪贴板</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>

    <!-- WPF 启动开销控制：去掉不需要的语言资源与调试符号，缩短首屏时间 -->
    <PublishTrimmed>false</PublishTrimmed>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- 性能与体积：ReadyToRun 让启动时少做 JIT；压缩单文件减小体积 -->
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 内置引擎图标（由 QuickSearch 的图标库转换而来，见 tools/qs_gen.py）。
         以 Resource 形式打包进程序，运行时不依赖磁盘或网络。 -->
    <Resource Include="Assets\engine-icons\*.png" />
  </ItemGroup>

</Project>
