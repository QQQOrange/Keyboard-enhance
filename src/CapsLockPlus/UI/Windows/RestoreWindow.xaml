<Window x:Class="CapsLockPlus.UI.Windows.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从备份恢复"
        Width="820" Height="660" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="4,1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <!-- 选中态必须自己画：默认模板在深色主题下是
                                 系统高亮底 + 白字，整行会糊成一条白带 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层再套一层无外边距的 Grid：离屏渲染要对"内容根"截图，
         根元素带 Margin 会让整张图向右下偏移、右下角被切掉。 -->
    <Grid Background="{DynamicResource Brush.Surface}">
        <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="从备份恢复" Style="{StaticResource Text.H2}" />
            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="先拉取备份清单，挑一份再决定怎么恢复。备份都是加密的，恢复时会用你设的备份密码解开。" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="CloudTab" Content="云端备份" Style="{StaticResource Button.Primary}"
                    Padding="14,6" Click="OnCloudTab" />
            <Button x:Name="LocalTab" Content="本地备份" Style="{StaticResource Button.Base}"
                    Padding="14,6" Margin="8,0,0,0" Click="OnLocalTab" />
            <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource Button.Ghost}"
                    Padding="12,6" Margin="14,0,0,0" Click="OnRefresh" />
            <Button x:Name="DeleteButton" Content="删除选中" Style="{StaticResource Button.Ghost}"
                    Padding="12,6" Margin="8,0,0,0" Click="OnDelete"
                    Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="10"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头：和下面每行用同一组固定列宽，保证对齐。
                     不用 GridView：它的表头模板走系统样式，深色主题下会
                     出现"白底白字"和选中行的系统高亮，而且离屏渲染时还会
                     多画一条错位的表头。自己拼一个反而干净。 -->
                <Border Grid.Row="0" Padding="10,7"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Grid.Column="1" Text="备份文件" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Grid.Column="2" Text="大小" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Grid.Column="3" Text="加密" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                </Border>

                <ListBox x:Name="BackupList" Grid.Row="1" BorderThickness="0"
                         Background="Transparent" SelectionMode="Single"
                         HorizontalContentAlignment="Left"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="390" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="恢复方式" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />

                <RadioButton x:Name="MergeRadio" GroupName="restoreMode" IsChecked="True"
                             Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12.5">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="合并恢复（推荐）" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Text="按主键对齐：同一个按键 / 宏 / 搜索项以备份里的为准，本地独有的内容保留。全局设置、网盘与备份密码不动。" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OverwriteRadio" GroupName="restoreMode" Margin="0,10,0,0"
                             Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12.5">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="覆盖恢复" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Text="整份替换成备份里的内容，本地当前配置会被清掉（恢复前会自动另存一份）。网盘与备份密码始终保留本机。" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource Button.Base}" Padding="16,7"
                    Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="RestoreButton" Content="恢复选中这份" Style="{StaticResource Button.Primary}"
                    Padding="18,7" Click="OnRestore" IsDefault="True" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="5" Style="{StaticResource Text.Tertiary}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Window>
