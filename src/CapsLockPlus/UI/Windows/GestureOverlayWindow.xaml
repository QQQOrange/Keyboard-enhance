<Window x:Class="CapsLockPlus.UI.Windows.GestureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手势轨迹"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True">
    <!--
        全屏透明覆盖层：只负责"看见"，不接任何输入。
        点击穿透靠 WS_EX_TRANSPARENT（见 code-behind），IsHitTestVisible 只挡住
        WPF 内部的命中测试，挡不住窗口本身。
    -->
    <Canvas x:Name="Root" Background="Transparent" IsHitTestVisible="False">
        <Polyline x:Name="Trail"
                  Stroke="#3B82F6"
                  StrokeThickness="3"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False" />

        <Border x:Name="LabelBox"
                Canvas.Left="0" Canvas.Top="0"
                Padding="10,5"
                CornerRadius="8"
                Background="#E6111827"
                BorderBrush="#553B82F6"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="LabelText"
                       Foreground="#FFF8FAFC"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>

        <!-- 方向串：画的过程中实时显示 ↑→，让用户知道"系统现在认为我在往哪拐" -->
        <Border x:Name="PatternBox"
                Canvas.Left="0" Canvas.Top="0"
                Padding="12,4"
                CornerRadius="8"
                Background="#CC0B1220"
                BorderBrush="#6658A6FF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="PatternText"
                       Foreground="#FFEAF2FF"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Segoe UI Symbol" />
        </Border>

        <!-- 下一步能接什么：只列"当前方向串再加一个方向"的手势，照 FlowMouse 的提示来 -->
        <Border x:Name="SuggestionBox"
                Canvas.Left="0" Canvas.Top="0"
                Padding="10,7"
                CornerRadius="8"
                Background="#B30B1220"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel x:Name="SuggestionList" />
        </Border>
    </Canvas>
</Window>
