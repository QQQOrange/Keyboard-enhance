<Window x:Class="CapsLockPlus.UI.Windows.StartupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动密码"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Text="启动密码保护" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="这个软件已设置启动密码，请输入密码进入主界面。" />

        <TextBlock x:Name="FieldLabel" Text="启动密码" FontSize="12" Margin="0,0,0,6"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <PasswordBox x:Name="PassBox" MinHeight="36" VerticalContentAlignment="Center"
                     Padding="10,0" KeyDown="OnKeyDown" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="退出" Padding="14,7" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="OkButton" Content="进入" Padding="20,7" Click="OnOk" IsDefault="True" />
        </StackPanel>

        <TextBlock x:Name="FootText" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   Text="启动密码与备份密码相互独立：这一个只决定谁能打开本软件，改了它也不会影响备份与数据加密。" />
    </StackPanel>
</Window>
