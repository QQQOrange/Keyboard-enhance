<Window x:Class="CapsLockPlus.UI.Windows.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        Title="{loc:T '发现新版本'}" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ShowActivated="True"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <Border CornerRadius="18" Background="{DynamicResource Brush.Surface}" BorderThickness="1"
            BorderBrush="{DynamicResource Brush.BorderStrong}" Margin="18">
        <Grid>
            <!-- 四行：内容 / 状态文字 / 进度条 / 按钮。
                 状态文字**独占一行**是必须的：放在按钮同一行时，英文按钮
                 （Skip this version / Download and install）把剩余宽度挤到
                 只剩 "Down…"，中文长句也会压到按钮上。空文本的 TextBlock
                 高度为 0，不显示状态时不占位置。 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,22,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{loc:T '发现新版本'}" Style="{StaticResource Text.H2}" />
                        <TextBlock x:Name="SubText" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Card.Flat}" Margin="0,16,0,0" Padding="14,11" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- 没填 GitHub 令牌（或没有与本机匹配的安装包）时**不提供程序内下载**：
                     这里只摆一个可点的下载地址，点它交给浏览器。底部那个「下载并安装」会被整个藏起来。 -->
                <Border x:Name="LinkCard" Style="{StaticResource Card.Flat}" Margin="0,10,0,0"
                        Padding="13,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LinkHint" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Text="{loc:T '没有填写 GitHub 个人访问令牌，这一版不能自动下载。点下面的地址用浏览器下载：'}" />
                        <Button x:Name="DownloadLinkButton" Style="{StaticResource Button.Ghost}"
                                Padding="0" Margin="0,6,0,0" HorizontalAlignment="Left" Cursor="Hand"
                                Click="OnOpenLinkClick"
                                ToolTip="{loc:T '在默认浏览器里打开这个版本的下载地址（新标签页）'}"
                                AutomationProperties.Name="{loc:T '在浏览器中打开 GitHub 下载地址'}"
                                AutomationProperties.HelpText="{loc:T '打开浏览器下载新版本'}">
                            <TextBlock x:Name="DownloadLinkText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       TextDecorations="Underline" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource Text.Tertiary}"
                       TextWrapping="Wrap" Margin="24,14,24,0" />

            <ProgressBar Grid.Row="2" x:Name="Progress" Height="4" Margin="24,12,24,0" Visibility="Collapsed"
                         Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.Accent}"
                         Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="0" />

            <Grid Grid.Row="3" Margin="24,16,24,22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="{loc:T '跳过此版本'}" Style="{StaticResource Button.Ghost}"
                            Click="OnSkip" />
                    <Button x:Name="LaterButton" Content="{loc:T '稍后'}" Style="{StaticResource Button.Base}"
                            Margin="6,0,0,0" Click="OnLater" />
                    <Button x:Name="DownloadButton" Content="{loc:T '下载并安装'}" Style="{StaticResource Button.Primary}"
                            Margin="8,0,0,0" Click="OnDownload" />
                    <!-- 下载中才出现：中断下载并回到初始状态（可以重试或直接关窗）。
                         没有它的时候，一旦点下「下载并安装」，三个按钮全被禁用、
                         窗口又没有标题栏关闭按钮 —— 只能等，慢网下等于卡死。 -->
                    <Button x:Name="CancelButton" Content="{loc:T '取消下载'}" Style="{StaticResource Button.Base}"
                            Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancelDownload"
                            ToolTip="{loc:T '中断这次下载（已下载的部分会被删掉），可以稍后重试'}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
