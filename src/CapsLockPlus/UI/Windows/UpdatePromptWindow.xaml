<Window x:Class="CapsLockPlus.UI.Windows.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <Border CornerRadius="18" Background="{DynamicResource Brush.Surface}" BorderThickness="1"
            BorderBrush="{DynamicResource Brush.BorderStrong}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,22,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="发现新版本" Style="{StaticResource Text.H2}" />
                        <TextBlock x:Name="SubText" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Card.Flat}" Margin="0,16,0,0" Padding="14,11" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <ProgressBar Grid.Row="1" x:Name="Progress" Height="4" Margin="24,16,24,0" Visibility="Collapsed"
                         Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.Accent}"
                         Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="0" />

            <Grid Grid.Row="2" Margin="24,18,24,22">
                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="跳过此版本" Style="{StaticResource Button.Ghost}"
                            Click="OnSkip" />
                    <Button x:Name="LaterButton" Content="稍后" Style="{StaticResource Button.Base}"
                            Margin="6,0,0,0" Click="OnLater" />
                    <Button x:Name="DownloadButton" Content="下载并安装" Style="{StaticResource Button.Primary}"
                            Margin="8,0,0,0" Click="OnDownload" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
