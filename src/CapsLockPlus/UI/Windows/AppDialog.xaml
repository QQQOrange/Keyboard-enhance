<Window x:Class="CapsLockPlus.UI.Windows.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup"
        Width="452"
        SizeToContent="Height"
        MinHeight="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        统一的确认 / 提示对话框，用来替掉零散的 MessageBox。

        为什么不用 MessageBox：
          · 它是系统对话框外壳，永远不跟应用主题走 —— 深色界面里弹一块白底，
            浅色界面里又弹一块灰底，和周围完全不是一套；
          · 按钮文字被系统语言决定（中文系统上是"确定/取消"，英文系统上是 OK/Cancel），
            和界面里其它按钮的措辞对不上；
          · 阻塞式 Win32 模态框，会吞掉快捷键钩子之外的所有消息循环行为，远程桌面下偶发白屏。

        这里保持同样的"模态阻塞"语义（ShowDialog），只是外观交给主题。
    -->
    <Border Padding="22,20,22,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行：图标 + 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Margin="0,1,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 正文 -->
            <TextBlock x:Name="BodyText" Grid.Row="1" Margin="27,10,0,0"
                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <!-- 按钮 -->
            <StackPanel x:Name="ButtonBar" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="{loc:T '取消'}" Style="{StaticResource Button.Ghost}"
                        Padding="16,7" MinWidth="76" Margin="0,0,8,0"
                        Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkButton" Content="{loc:T '确定'}" Style="{StaticResource Button.Primary}"
                        Padding="18,7" MinWidth="88"
                        Click="OnOk" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
