<Window x:Class="CapsLockPlus.UI.Windows.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="248" Height="52"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Title="按键增强 横条">

    <!-- 亮度横条：造型对齐 Windows 自己的音量横条 ——
         一行「图标 + 进度条 + 数字」，没有多余文字，尺寸更紧凑。

         配色**跟随主题**（白夜/深浅模式）：深色主题用深底浅字，
         浅色主题用浅底深字 + 蓝色进度。写死深色会在白天模式里
         变成一块突兀的黑板，这正是之前的问题。 -->
    <Border x:Name="Card" CornerRadius="13"
            Background="{DynamicResource Brush.OsdCard}"
            BorderBrush="{DynamicResource Brush.OsdCardBorder}"
            BorderThickness="1" Padding="15,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 图标：亮度 -->
            <TextBlock x:Name="IconText" Grid.Column="0"
                       Text="&#xE706;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="19" Foreground="{DynamicResource Brush.OsdText}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />

            <!-- 进度条：底槽 + 填充。
                 填充用**星号比例列**而不是固定宽度：固定宽度要靠
                 Track.ActualWidth 来算，而窗口刚显示时布局还没完成，
                 算出来是 0，进度条就永远是空的（踩过）。 -->
            <Grid x:Name="Track" Grid.Column="1" Height="5" VerticalAlignment="Center">
                <Border CornerRadius="2.5" Background="{DynamicResource Brush.OsdTrack}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillColumn" />
                        <ColumnDefinition x:Name="RestColumn" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2.5"
                            Background="{DynamicResource Brush.OsdFill}" />
                </Grid>
            </Grid>

            <TextBlock x:Name="ValueText" Grid.Column="2" Text="0"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.OsdText}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       MinWidth="30" TextAlignment="Right" />
        </Grid>
    </Border>
</Window>
