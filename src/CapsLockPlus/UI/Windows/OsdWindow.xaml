<Window x:Class="CapsLockPlus.UI.Windows.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="208" Height="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Title="按键增强 横条">

    <!-- 亮度横条：造型对齐 Windows 自己的音量横条 ——
         一行「图标 + 进度条 + 数字」，没有多余文字，尺寸更紧凑（208×44，约 4.7:1）。

         配色**跟随主题**（白夜/深浅模式），而且两边都是**蓝色系**：
         浅色主题用强调蓝，深色主题用压暗的同族蓝 —— 不再出现"白天蓝、夜里白"。
         进度条、图标、数字三者同色，风格才统一。 -->
    <Border x:Name="Card" CornerRadius="11"
            Background="{DynamicResource Brush.OsdCard}"
            BorderBrush="{DynamicResource Brush.OsdCardBorder}"
            BorderThickness="1" Padding="13,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 图标：亮度。颜色跟进度条/数字同源（Brush.OsdText）。 -->
            <TextBlock x:Name="IconText" Grid.Column="0"
                       Text="&#xE706;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="17" Foreground="{DynamicResource Brush.OsdText}"
                       VerticalAlignment="Center" Margin="0,0,11,0" />

            <!-- 进度条：底槽 + 填充。
                 填充用**星号比例列**而不是固定宽度：固定宽度要靠
                 Track.ActualWidth 来算，而窗口刚显示时布局还没完成，
                 算出来是 0，进度条就永远是空的（踩过）。 -->
            <Grid x:Name="Track" Grid.Column="1" Height="4" VerticalAlignment="Center">
                <Border CornerRadius="2" Background="{DynamicResource Brush.OsdTrack}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillColumn" />
                        <ColumnDefinition x:Name="RestColumn" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2"
                            Background="{DynamicResource Brush.OsdFill}" />
                </Grid>
            </Grid>

            <TextBlock x:Name="ValueText" Grid.Column="2" Text="0"
                       FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.OsdText}"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       MinWidth="26" TextAlignment="Right" />
        </Grid>
    </Border>
</Window>
