<Window x:Class="CapsLockPlus.UI.Windows.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="216" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Title="按键增强 横条">

    <!-- 亮度横条 —— 逐项对齐 Windows 自己的音量横条：
         192×48 深色圆角卡片（圆角 6）、无边框、带柔和阴影，
         一行「图标 + 进度条 + 数字」；进度条用系统强调色的浅色档，
         图标与数字纯白。**不跟随应用主题** —— 系统那条横条在浅色桌面上
         也仍然是深色卡片（实测），跟着主题变反而会"白天蓝、夜里白"。

         尺寸在这里只作为设计参考：真正的尺寸由代码里的
         DesignWidth/DesignHeight/ShadowPad 决定（定位也要用同一组数字）。 -->
    <Grid>
        <Border x:Name="Card" Margin="12" CornerRadius="6" Background="#F02D2D2D"
                BorderThickness="0" Padding="13,0,12,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.24" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 图标：亮度。和系统那条一样是纯白。 -->
                <TextBlock x:Name="IconText" Grid.Column="0"
                           Text="&#xE706;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,13,0" />

                <!-- 进度条：底槽 + 填充（星号比例列，避免布局未完成时宽度为 0）。
                     槽 = 白色 55%，填充 = 系统强调色浅档（运行时注入）。 -->
                <Grid x:Name="Track" Grid.Column="1" Height="5" VerticalAlignment="Center">
                    <Border x:Name="TrackBar" CornerRadius="2.5" Background="#8CFFFFFF" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FillColumn" />
                            <ColumnDefinition x:Name="RestColumn" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FillBar" Grid.Column="0" CornerRadius="2.5"
                                Background="#4CC2FF" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="ValueText" Grid.Column="2" Text="0"
                           FontSize="14" FontWeight="Normal"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           MinWidth="26" TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
