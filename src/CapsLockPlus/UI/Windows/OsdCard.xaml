<UserControl x:Class="CapsLockPlus.UI.Windows.OsdCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             IsHitTestVisible="False" Focusable="False"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <!-- 亮度横条的**唯一一份**视觉定义。
         两个宿主共用它：
           · OsdWindow  —— 普通 WPF 窗口（band 上不去时的老路径）；
           · OsdBandSurface —— band 16 的分层窗口（离屏渲染成位图）。

         卡片 192×48 DIP、圆角 7.5、四周留 12 DIP 给阴影，
         所以控件整体 216×72 DIP。数值的实测依据见 OsdWindow 的注释。 -->
    <Grid x:Name="Root">
        <Border x:Name="Card" Margin="12" CornerRadius="7.5" Background="#F02D2D2D"
                BorderThickness="0" Padding="13,0,12,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.24" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 图标：亮度。和系统那条一样是纯白。 -->
                <TextBlock x:Name="IconText" Grid.Column="0"
                           Text="&#xE706;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,13,0" />

                <!-- 进度条：底槽 + 填充（星号比例列，避免布局未完成时宽度为 0）。
                     槽 = 白色 55%，填充 = 系统强调色浅档（运行时注入）。 -->
                <Grid x:Name="Track" Grid.Column="1" Height="5" VerticalAlignment="Center">
                    <Border x:Name="TrackBar" CornerRadius="2.5" Background="#8CFFFFFF" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FillColumn" />
                            <ColumnDefinition x:Name="RestColumn" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FillBar" Grid.Column="0" CornerRadius="2.5"
                                Background="#4CC2FF" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="ValueText" Grid.Column="2" Text="0"
                           FontSize="14" FontWeight="Normal"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           MinWidth="26" TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
