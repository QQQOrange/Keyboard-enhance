<UserControl x:Class="CapsLockPlus.UI.Windows.OsdCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             IsHitTestVisible="False" Focusable="False"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <!-- 亮度横条的**唯一一份**视觉定义。
         两个宿主共用它：
           · OsdWindow  —— 普通 WPF 窗口（band 上不去时的老路径）；
           · OsdBandSurface —— band 16 的分层窗口（离屏渲染成位图）。

         卡片 192×47 DIP、圆角 7.5、四周留 12 DIP 给阴影，
         所以控件整体 216×71 DIP。

         ⚠ 这里写的尺寸只是"设计器的默认值"。真正生效的每一个数
         都由 OsdCard 的构造函数从 Core/Windows/OsdPlacement.cs 的常量
         覆盖一遍 —— 那边是唯一的真相，因为它们是从系统横条的
         截图上逐像素量出来的（见 OsdPlacement 的注释）。 -->
    <Grid x:Name="Root">
        <Border x:Name="Card" Margin="12" CornerRadius="7.5" Background="#F02D2D2D"
                BorderThickness="0" Padding="12.25,0,13,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.24" Color="#000000" />
            </Border.Effect>

            <Grid x:Name="Layout">
                <Grid.ColumnDefinitions>
                    <!-- 图标槽 → 图标到进度条的间距 → 进度条（弹性）→ 数字 -->
                    <ColumnDefinition x:Name="IconColumn" Width="16" />
                    <ColumnDefinition x:Name="IconGapColumn" Width="13.75" />
                    <ColumnDefinition x:Name="TrackColumn" Width="*" />
                    <ColumnDefinition x:Name="ValueColumn" Width="27" />
                </Grid.ColumnDefinitions>

                <!-- 图标：自绘太阳 —— 几何照 Windows 11 原版（Segoe Fluent Icons E706）。
                     原版是"**空心圆环** + 8 根分离的胶囊状射线"，环与线之间有
                     2 DIP 的空气。旧版画成实心圆盘、射线内端插进圆里，两者必然
                     连成一整块 —— 用户说的"黏连"就是这个。
                     用户另外要求（仍然有效）：中心圆直径固定不缩放、整体放大、
                     射线边伸缩边旋转且转速与亮度变化联动。
                     结构：SunRays 里 8 根射线（代码生成，外端随亮度伸缩），
                     外面套 RotateTransform 绕槽中心旋转；SunRing 是**描边**椭圆
                     （不是填充盘），画在射线上层，尺寸恒定。
                     几何常量全部在 Core/Windows/OsdPlacement.cs。 -->
                <Grid x:Name="IconBox" Grid.Column="0" Width="16" Height="16"
                      VerticalAlignment="Center">
                    <!-- 射线层：关掉像素吸附 —— 旋转时端点会连续移动，
                         吸附到整像素会让细线出现台阶式抖动。 -->
                    <Grid x:Name="SunRays" Width="16" Height="16"
                          SnapsToDevicePixels="False" UseLayoutRounding="False"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SunSpin" Angle="0" />
                        </Grid.RenderTransform>
                    </Grid>
                    <!-- 圆环：描边椭圆，Stroke 在代码里给（跟随文字色）。
                         Fill 必须为 null —— 填成实心就退回旧版那团黑饼了。 -->
                    <Ellipse x:Name="SunRing" Width="7" Height="7"
                             Fill="{x:Null}" StrokeThickness="1"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- 进度条：底槽 + 填充（星号比例列，避免布局未完成时宽度为 0）。
                     槽 = 白色 55%，填充 = 系统强调色浅档（运行时注入）。 -->
                <Grid x:Name="Track" Grid.Column="2" Height="4" VerticalAlignment="Center">
                    <Border x:Name="TrackBar" CornerRadius="2" Background="#8CFFFFFF" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FillColumn" />
                            <ColumnDefinition x:Name="RestColumn" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FillBar" Grid.Column="0" CornerRadius="2"
                                Background="#4CC2FF" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="ValueText" Grid.Column="3" Text="0"
                           FontSize="14" FontWeight="Normal"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           MinWidth="27" TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
