<Window x:Class="CapsLockPlus.UI.Windows.SnippetRecoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        Title="{loc:T '找回丢失的别名'}"
        Width="560" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Style="{StaticResource Card}" Padding="22,20,22,18" Margin="0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{loc:T '找回丢失的别名'}" Style="{StaticResource Text.H3}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Tertiary}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{loc:T '全选'}" Style="{StaticResource Button.Ghost}" Padding="12,6"
                        Click="OnSelectAllClick" />
                <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Base}" Padding="14,6" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancelClick" />
                <Button x:Name="RestoreButton" Content="{loc:T '恢复选中'}" Style="{StaticResource Button.Primary}"
                        Padding="16,6" Margin="8,0,0,0" Click="OnRestoreClick" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceSoft}"
                    CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                           Text="{loc:T '只补「当前配置里没有的」：同触发词的现有版本不会被覆盖。恢复后照常保存到配置里。'}" />
            </Border>

            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel x:Name="RowPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
