<Window x:Class="CapsLockPlus.UI.Windows.SubLayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup"
        Title="{loc:T '层内子层设置'}" Width="560" Height="620" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="{loc:T '层内子层'}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" />

        <TextBlock Grid.Row="1" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{loc:T '进入本层后再按住下面配置的键，就能用到另一套独立绑定。子层键可以是任意物理键（Ctrl、Tab、CapsLock…），也能给它起个名字。最多 10 个。'}" />

        <!-- 子层列表 -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="10"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <ItemsControl x:Name="SubList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10,9" CornerRadius="9"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 子层键：点击可捕获任意键 -->
                                    <Button Grid.Column="0" Content="{Binding KeyLabel}"
                                            Style="{StaticResource Button.Base}" Padding="10,6"
                                            Click="OnPickKeyClick" Tag="{Binding}" />

                                    <!-- 自定义名字。
                                         这里**不写 Height 也不写 MinHeight**，用 TextBox.Base 的
                                         MinHeight=38：Padding 10,6 + 边框 1，内容区 = 38-14 = 24px，
                                         比一行字（约 20px）高，任何 DPI 都不会裁字。
                                         早先写死 Height=34，内容区只剩 20px —— 表现为
                                         "只看到字符上半部分，下半部分被边框切掉"。 -->
                                    <TextBox Grid.Column="1" Style="{StaticResource TextBox.Base}"
                                             VerticalContentAlignment="Center"
                                             Margin="8,0,8,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:T '留空则用键名自身'}" />

                                    <Button Grid.Column="2" Content="{loc:T '删除'}" Style="{StaticResource Button.Ghost}"
                                            Padding="10,6" Click="OnRemoveClick" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:T '+ 添加子层'}" Style="{StaticResource Button.Base}" Padding="14,7"
                    Click="OnAddClick" />
            <Button Content="{loc:T '恢复默认'}" Style="{StaticResource Button.Ghost}" Padding="12,7"
                    Margin="8,0,0,0" Click="OnResetDefaults" />
            <TextBlock x:Name="CountText" Style="{StaticResource Text.Tertiary}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Base}" Padding="16,7" Click="OnCancel" />
            <Button Content="{loc:T '保存'}" Style="{StaticResource Button.Primary}" Padding="16,7"
                    Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
