<Window x:Class="CapsLockPlus.UI.Windows.SubLayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="层内修饰键（子层）" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <StackPanel Margin="22,18">
        <TextBlock x:Name="TitleText" Text="层内修饰键" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" />
        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="勾选这一层要用的修饰键组合。进入本层后再按住这些键，就能用到另一套独立绑定。最多 10 个。" />

        <ItemsControl x:Name="ModifierList" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="9"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.TextPrimary}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="CountText" Style="{StaticResource Text.Tertiary}" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="恢复默认" Style="{StaticResource Button.Ghost}" Padding="12,7"
                    Click="OnResetDefaults" />
            <Button Content="取消" Style="{StaticResource Button.Base}" Padding="16,7" Margin="10,0,0,0"
                    Click="OnCancel" />
            <Button Content="保存" Style="{StaticResource Button.Primary}" Padding="16,7"
                    Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
