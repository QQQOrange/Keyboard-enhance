<Window x:Class="CapsLockPlus.UI.Windows.SearchPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="14" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索框 -->
            <Grid Grid.Row="0" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox Grid.Column="1" x:Name="QueryBox" Style="{StaticResource TextBox.Base}"
                         MinHeight="38" VerticalContentAlignment="Center" FontSize="14"
                         TextChanged="OnQueryChanged" />
            </Grid>

            <!-- 结果 -->
            <ListBox Grid.Row="1" x:Name="ResultList" Background="Transparent" BorderThickness="0"
                     Margin="8,0,8,0" ItemContainerStyle="{StaticResource RowItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="5" Padding="7,2" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="{Binding Kind}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />

                            <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Text.Tertiary}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部提示 -->
            <TextBlock Grid.Row="2" x:Name="HintText" Style="{StaticResource Text.Tertiary}"
                       Margin="18,8,18,12" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
