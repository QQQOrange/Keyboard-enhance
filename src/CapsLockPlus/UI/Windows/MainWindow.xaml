<Window x:Class="CapsLockPlus.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        xmlns:views="clr-namespace:CapsLockPlus.UI.Views"
        Title="{loc:T '按键增强 Keyboard Enhance'}" Height="800" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowGradient}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,12,18">
                    <!-- 这里的图标必须和 exe / 任务栏上的应用图标**完全一致**。
                         以前用 Segoe 图标字体的键盘 glyph 配渐变底，
                         跟应用程序图标 (Assets/app.ico) 根本不是一个东西。 -->
                    <Image Width="40" Height="40" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T '按键增强'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Keyboard Enhance · Win11 x64" Style="{StaticResource Text.Tertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="guide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '快速上手'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="keys">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '按键映射'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="qbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T 'Qbar 面板'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '剪贴板'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="macros">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '宏'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="layers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '触发键与层'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '同步与备份'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '设置'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="test">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '测试'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="help">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '快捷键速查'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '关于'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 状态卡 -->
                <Border Grid.Row="2" Margin="12,8,12,14" CornerRadius="12" Padding="13,11"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="{loc:T '正在运行'}" Margin="7,0,0,0"
                                       Style="{StaticResource Text.Secondary}" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock x:Name="HookText" Text="{loc:T '键盘钩子正常'}" Margin="0,4,0,0"
                                   Style="{StaticResource Text.Tertiary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右侧内容 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="{loc:T '快速上手'}" Style="{StaticResource Text.H2}" />
                    <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                        <TextBlock x:Name="PageBadge" Text="{loc:T 'CapsLock 增强'}" Style="{StaticResource Badge.Text}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PauseButton" Style="{StaticResource Button.Ghost}" Click="OnPauseClick"
                            Content="{loc:T '暂停'}" ToolTip="{loc:T '临时暂停所有按键增强热键'}" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnThemeClick" Content="&#xE793;"
                            ToolTip="{loc:T '切换深浅色'}" Margin="2,0,0,0" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnMinimizeClick" Content="&#xE921;"
                            ToolTip="{loc:T '最小化'}" Margin="2,0,0,0" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnCloseClick" Content="&#xE8BB;"
                            ToolTip="{loc:T '关闭到托盘'}" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 页面容器：按需创建，避免启动时把 8 个页面全部构建出来 -->
            <Grid Grid.Row="1">
                <ContentControl x:Name="PageHost" />
            </Grid>
        </Grid>
    </Grid>
</Window>
