<Window x:Class="CapsLockPlus.UI.Windows.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup"
        Title="{loc:T '解锁本地数据'}"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Text="{loc:T '本地数据已加密'}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{loc:T '请输入你在「同步与备份」里设置的备份密码。只需要这一次 —— 解锁后密钥会交给 Windows 凭据缓存，以后启动不再询问。'}" />

        <TextBlock x:Name="FieldLabel" Text="{loc:T '备份密码'}" FontSize="12" Margin="0,0,0,6"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <PasswordBox x:Name="PassBox" MinHeight="36" VerticalContentAlignment="Center"
                     Padding="10,0" KeyDown="OnKeyDown" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SkipButton" Content="{loc:T '先不解锁'}" Padding="14,7" Margin="0,0,8,0" Click="OnSkip" />
            <Button x:Name="OkButton" Content="{loc:T '解锁'}" Padding="20,7" Click="OnOk" IsDefault="True" />
        </StackPanel>

        <TextBlock x:Name="FootText" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   Text="{loc:T '选择「先不解锁」会以空白配置启动，并且不会写入磁盘 —— 你原来的数据不会被覆盖。'}" />
    </StackPanel>
</Window>
