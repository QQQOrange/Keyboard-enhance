<Window x:Class="CapsLockPlus.UI.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择窗口" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Cursor="Cross" FontFamily="{StaticResource Font.Ui}">

    <!-- 遮罩：整块半透明，鼠标完全穿透（代码里设 WS_EX_TRANSPARENT），
         所以点击会直达下面的真实窗口。事件靠全局鼠标钩子来抓，
         不在这里挂 MouseMove/MouseDown —— 遮罩根本收不到这些事件。 -->
    <Grid x:Name="Root" Background="#33000000" Cursor="Cross" IsHitTestVisible="False"
          Focusable="False">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                    IsHitTestVisible="False">
            <Border CornerRadius="12" Background="#F2161A23" Padding="18,12"
                    BorderBrush="#335B93FF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="点击要绑定的窗口" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F2F5FA" HorizontalAlignment="Center" />
                    <TextBlock Text="左键选中　·　右键或 Esc 取消" FontSize="12" Foreground="#9FB0CC"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                    IsHitTestVisible="False">
            <Border CornerRadius="12" Background="#F2161A23" Padding="18,12"
                    BorderBrush="#335B93FF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="点击要绑定的窗口" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F2F5FA" HorizontalAlignment="Center" />
                    <TextBlock Text="按 Esc 取消" FontSize="12" Foreground="#9FB0CC"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 悬停窗口的名称与范围提示 -->
        <Border x:Name="HoverInfo" CornerRadius="10" Background="#E6161A23" Padding="12,8"
                BorderBrush="#335B93FF" BorderThickness="1" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="HoverTitle" FontSize="13" Foreground="#F2F5FA"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock x:Name="HoverProcess" FontSize="11.5" Foreground="#8FA3C4" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 高亮框：跟随鼠标指向的窗口 -->
        <Border x:Name="Highlight" BorderBrush="#5B93FF" BorderThickness="2" CornerRadius="6"
                Background="#205B93FF" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
