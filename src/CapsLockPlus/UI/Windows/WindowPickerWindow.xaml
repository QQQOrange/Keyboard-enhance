<Window x:Class="CapsLockPlus.UI.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup"
        Title="{loc:T '选择窗口'}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Cursor="Cross" FontFamily="{StaticResource Font.Ui}">

    <!-- 遮罩：整块半透明，鼠标完全穿透（代码里设 WS_EX_TRANSPARENT），
         所以点击会直达下面的真实窗口。事件靠全局鼠标钩子来抓，
         不在这里挂 MouseMove/MouseDown —— 遮罩根本收不到这些事件。 -->
    <Grid x:Name="Root" Background="{DynamicResource Brush.OverlayScrim}" Cursor="Cross" IsHitTestVisible="False"
          Focusable="False">

        <!-- 顶部提示。只放一块 —— 之前这里重复写了两块一模一样的卡片，
             文字还不一致（一块写"左键选中 · 右键或 Esc 取消"，一块写"按 Esc 取消"），
             叠在一起显示，看起来像重影。 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                    IsHitTestVisible="False">
            <Border Style="{StaticResource Overlay.CardAlt}" Padding="18,12"
                    BorderBrush="{DynamicResource Brush.OverlayBorderAccent}">
                <StackPanel>
                    <TextBlock Text="{loc:T '点击要绑定的窗口'}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.OverlayText}" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T '左键选中　·　右键或 Esc 取消'}" FontSize="12"
                               Foreground="{DynamicResource Brush.OverlayTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 悬停窗口的名称与范围提示 -->
        <Border x:Name="HoverInfo" Style="{StaticResource Overlay.Card}" CornerRadius="10" Padding="12,8"
                BorderBrush="{DynamicResource Brush.OverlayBorderAccent}" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="HoverTitle" FontSize="13" Foreground="{DynamicResource Brush.OverlayText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock x:Name="HoverProcess" FontSize="11.5"
                               Foreground="{DynamicResource Brush.OverlayTextTertiary}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 高亮框：跟随鼠标指向的窗口 -->
        <Border x:Name="Highlight" BorderBrush="{DynamicResource Brush.OverlayAccent}" BorderThickness="2" CornerRadius="6"
                Background="{DynamicResource Brush.OverlayAccentSoft}" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
