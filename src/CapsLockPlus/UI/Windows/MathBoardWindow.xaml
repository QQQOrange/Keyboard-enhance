<Window x:Class="CapsLockPlus.UI.Windows.MathBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计算器" Width="520" Height="640" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowGradient}"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="计算器" Style="{StaticResource Text.H3}" Margin="20,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    Margin="0,0,10,0" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,4,20,12">
            <TextBox x:Name="Expression" Style="{StaticResource TextBox.Base}" Height="52" FontSize="20"
                     FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center"
                     TextChanged="OnExpressionChanged" PreviewKeyDown="OnExpressionKeyDown" />
            <Grid Margin="0,10,0,0">
                <TextBlock x:Name="Result" Text="0" FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Accent}" />
                <Button Content="复制结果" Style="{StaticResource Button.Base}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnCopyResult" />
            </Grid>
            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,12" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <TextBlock Text="历史记录" Style="{StaticResource Text.Secondary}" />
                    <Button Content="清空" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                            Click="OnClearHistory" />
                </Grid>
                <ListBox Grid.Row="1" x:Name="History" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnHistoryDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Expression}" Style="{StaticResource Text.Tertiary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 数字键盘 -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="20,0,20,18" Rows="5">
            <Button Content="C" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnClear" />
            <Button Content="(" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content=")" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="÷" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />

            <Button Content="7" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="8" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="9" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="×" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />

            <Button Content="4" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="5" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="6" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="−" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />

            <Button Content="1" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="2" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="3" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="+" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />

            <Button Content="0" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="." Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnInsert" />
            <Button Content="⌫" Style="{StaticResource Button.Base}" Margin="4" Height="46" Click="OnBackspace" />
            <Button Content="=" Style="{StaticResource Button.Primary}" Margin="4" Height="46" Click="OnEquals" />
        </UniformGrid>
    </Grid>
</Window>
