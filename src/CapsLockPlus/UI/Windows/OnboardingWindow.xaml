<Window x:Class="CapsLockPlus.UI.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 CapsLock+" Width="820" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <Grid Margin="24">
        <Border CornerRadius="20" Background="{DynamicResource Brush.Surface}" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.BorderStrong}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：品牌区 -->
                <Border Grid.Column="0" CornerRadius="20,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2B6CF6" Offset="0" />
                            <GradientStop Color="#5B5BF0" Offset="0.5" />
                            <GradientStop Color="#22C1E8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="30,0">
                            <Border Width="64" Height="64" CornerRadius="18" Background="#33FFFFFF"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7E6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="30" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="CapsLock+" FontSize="30" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,22,0,0" />
                            <TextBlock Text="让 Caps 键成为你最顺手的修饰键" Foreground="#DCE9FF" FontSize="13.5"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel Margin="0,26,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#B8E6FF" VerticalAlignment="Center" />
                                    <TextBlock Text="光标移动不用离开主键区" Foreground="#EAF3FF" FontSize="12.5"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#B8E6FF" VerticalAlignment="Center" />
                                    <TextBlock Text="一个 Qbar 搞定搜索与启动" Foreground="#EAF3FF" FontSize="12.5"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#B8E6FF" VerticalAlignment="Center" />
                                    <TextBlock Text="全部设置都能可视化修改" Foreground="#EAF3FF" FontSize="12.5"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右：步骤 -->
                <Grid Grid.Column="1" Margin="34,28,34,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="StepTitle" Text="欢迎" Style="{StaticResource Text.H1}" />
                        <TextBlock x:Name="StepSubtitle" Text="花一分钟做三个选择，之后就能一直用了。"
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <!-- 第 1 步 -->
                        <StackPanel x:Name="Step1">
                            <TextBlock Text="1 · 选一个按键方案" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="两种方案功能一样，只是字母键的位置不同。不确定就选 Capslox。"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <RadioButton x:Name="SchemeCapslox" GroupName="scheme" IsChecked="True" Margin="0,0,0,10"
                                         Checked="OnSchemeChecked">
                                <StackPanel>
                                    <TextBlock Text="Capslox（默认，推荐）" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="Caps+S/D/E/F 移动，Caps+J/K/I/L 选择"
                                               Style="{StaticResource Text.Tertiary}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SchemeClassic" GroupName="scheme" Checked="OnSchemeChecked">
                                <StackPanel>
                                    <TextBlock Text="经典 CapsLock+ 3.0 之前" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="Caps+LAlt+方向 切窗口，Caps+Z 撤销重做"
                                               Style="{StaticResource Text.Tertiary}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- 第 2 步 -->
                        <StackPanel x:Name="Step2" Visibility="Collapsed">
                            <TextBlock Text="2 · 是否开机自启" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="开启后登录 Windows 就会自动在托盘运行，随时可用。"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <RadioButton x:Name="StartupOn" GroupName="startup" IsChecked="True" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="开启（推荐）" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="开机即可用，不占用桌面" Style="{StaticResource Text.Tertiary}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="StartupOff" GroupName="startup">
                                <StackPanel>
                                    <TextBlock Text="先不开" Style="{StaticResource Text.Body}" />
                                    <TextBlock Text="以后可以在设置里随时打开" Style="{StaticResource Text.Tertiary}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- 第 3 步 -->
                        <StackPanel x:Name="Step3" Visibility="Collapsed">
                            <TextBlock Text="3 · 试一下" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="按下面的顺序按一遍，就能体会到它和普通改键的区别。"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,6,0,16" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Card.Flat}" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Caps" FontSize="11.5" /></Border>
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="S" FontSize="11.5" /></Border>
                                        <TextBlock Text="光标左移一个字符" Style="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Caps" FontSize="11.5" /></Border>
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Q" FontSize="11.5" /></Border>
                                        <TextBlock Text="打开 Qbar，输入 calc 回车" Style="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Caps" FontSize="11.5" /></Border>
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="F2" FontSize="11.5" /></Border>
                                        <TextBlock Text="打开计算器" Style="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock x:Name="StepDots" Text="● ○ ○" Style="{StaticResource Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SkipButton" Content="跳过" Style="{StaticResource Button.Ghost}"
                                    Click="OnSkip" />
                            <Button x:Name="BackButton" Content="上一步" Style="{StaticResource Button.Base}"
                                    Margin="8,0,0,0" Click="OnBack" Visibility="Collapsed" />
                            <Button x:Name="NextButton" Content="下一步" Style="{StaticResource Button.Primary}"
                                    Margin="8,0,0,0" Click="OnNext" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
