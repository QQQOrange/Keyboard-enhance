<Window x:Class="CapsLockPlus.UI.Windows.NewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        Title="{loc:T '设置启动密码'}"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Text="{loc:T '设置启动密码'}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{loc:T '设好后，每次启动本软件都要先输入这个密码才能进入主界面。'}" />

        <TextBlock Text="{loc:T '新密码'}" FontSize="12" Margin="0,0,0,6"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <PasswordBox x:Name="PassBox" MinHeight="36" VerticalContentAlignment="Center"
                     Padding="10,0" KeyDown="OnKeyDown" />

        <TextBlock Text="{loc:T '再输一遍确认'}" FontSize="12" Margin="0,12,0,6"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <PasswordBox x:Name="ConfirmBox" MinHeight="36" VerticalContentAlignment="Center"
                     Padding="10,0" KeyDown="OnKeyDown" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{loc:T '取消'}" Padding="14,7" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="OkButton" Content="{loc:T '确定'}" Padding="20,7" Click="OnOk" IsDefault="True" />
        </StackPanel>

        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   Text="{loc:T '至少 4 位。启动密码与备份密码相互独立，互不影响。忘记密码可删除数据目录里的 startup.json 解除保护（其他设置不受影响）。'}" />
    </StackPanel>
</Window>
