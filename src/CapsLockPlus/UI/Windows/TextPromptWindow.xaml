<Window x:Class="CapsLockPlus.UI.Windows.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        Title="{loc:T '输入名称'}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Ui}">

    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" Text="{loc:T '输入名称'}" />
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,14"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <TextBox x:Name="InputBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                 VerticalContentAlignment="Center" KeyDown="OnKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Ghost}" Padding="14,7"
                    Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:T '确定'}" Style="{StaticResource Button.Primary}" Padding="20,7"
                    Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
