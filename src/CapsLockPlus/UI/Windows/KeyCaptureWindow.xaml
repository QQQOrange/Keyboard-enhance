<Window x:Class="CapsLockPlus.UI.Windows.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
        Title="{loc:T '自定义按键'}" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.Ui}">

    <Grid Margin="14">
        <Border CornerRadius="18" Background="{DynamicResource Brush.OverlayShadow}" Margin="8,12,8,-2" />
        <Border CornerRadius="16" BorderThickness="1.5" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}">
            <StackPanel Margin="20,18">
                <TextBlock Text="{loc:T '按下目标组合键'}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="{loc:T '例如 Ctrl+Shift+K、Alt+D。支持小键盘、功能键、媒体键等键盘上不显示的按键。&#x0a;Esc 取消。'}"
                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- 捕获显示区 -->
                <Border Margin="0,16,0,0" Padding="18,14" CornerRadius="12"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1">
                    <StackPanel>
                        <!-- 修饰键状态指示 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Border x:Name="CtrlBadge" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="Ctrl" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                            <Border x:Name="ShiftBadge" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="Shift" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                            <Border x:Name="AltBadge" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="Alt" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                            <Border x:Name="WinBadge" CornerRadius="6" Padding="8,3"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <TextBlock Text="Win" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="PromptText" Text="{loc:T '等待按键…'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DetailText" Text="" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Ghost}" Padding="16,7"
                            Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="{loc:T '确定绑定'}" Style="{StaticResource Button.Primary}" Padding="16,7"
                            Click="OnConfirm" IsEnabled="False" x:Name="ConfirmButton" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
