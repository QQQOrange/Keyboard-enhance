<Window x:Class="CapsLockPlus.UI.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        FontFamily="{StaticResource Font.Ui}">
    <!-- 配色走主题（Brush.Overlay*）：浅色主题下是半透明白 + 深色字，不再是一块黑板 -->
    <Border x:Name="Card" Style="{StaticResource Overlay.CardAlt}" Padding="16,11" Margin="14">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="7"
                    Background="{DynamicResource Brush.OverlayAccentSoft}"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource Brush.OverlayAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Message" Text="" Foreground="{DynamicResource Brush.OverlayText}" FontSize="13" Margin="10,0,0,0"
                       VerticalAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
