<Window x:Class="CapsLockPlus.UI.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        FontFamily="{StaticResource Font.Ui}">
    <Border x:Name="Card" CornerRadius="12" Background="#F2161A23" Padding="16,11" Margin="14"
            BorderThickness="1" BorderBrush="#33FFFFFF">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="7" Background="#2E5B93FF"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="#8FB6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Message" Text="" Foreground="#F2F5FA" FontSize="13" Margin="10,0,0,0"
                       VerticalAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
