<Window x:Class="CapsLockPlus.UI.Windows.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译" Width="560" Height="520" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowGradient}"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="翻译" Style="{StaticResource Text.H3}" Margin="20,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    Margin="0,0,10,0" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,0,20,12">
            <TextBlock x:Name="SourceLabel" Style="{StaticResource Text.Tertiary}" Text="原文" />
            <TextBox x:Name="SourceText" Style="{StaticResource TextBox.Base}" Height="110" Margin="0,6,0,0"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox x:Name="TargetBox" Style="{StaticResource ComboBox.Base}" Width="150"
                          SelectionChanged="OnTargetChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-CHS" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                </ComboBox>
                <Button Content="翻译" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Click="OnTranslate" />
                <Button Content="用选中的文本" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                        Click="OnUseSelection" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultText" Text="译文会显示在这里" Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="20,0,20,18">
            <Button Content="复制译文" Style="{StaticResource Button.Base}" Click="OnCopy" />
            <Button Content="替换原文" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                    Click="OnReplace" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
