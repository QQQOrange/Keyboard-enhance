<UserControl x:Class="CapsLockPlus.UI.Views.BindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明 + 两种绑定方式 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="把窗口钉在 Caps+1 ~ Caps+0 上" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="共 10 个槽位。绑定后按 Caps+数字 即可切回该窗口，窗口会由小到大展开。"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 目标槽位选择 -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="目标槽位" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox x:Name="SlotPicker" Style="{StaticResource ComboBox.Base}" Width="170"
                              SelectionChanged="OnSlotPickerChanged" />
                    <TextBlock x:Name="SlotHint" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <!-- 两种绑定方式 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card.Flat}" Padding="14,12" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="方式一：选择程序文件" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="适合「这个键永远对应某个软件」。即使它当前没在运行，按槽位也会自动帮你打开。"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <Button Content="选择 exe 文件…" Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Left" Click="OnPickExe" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card.Flat}" Padding="14,12" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="方式二：十字准星点选" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="点下面的按钮后鼠标变成十字准星，去点你想绑定的那个窗口即可。"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <Button Content="开始点选窗口" Style="{StaticResource Button.Base}"
                                    HorizontalAlignment="Left" Click="OnStartPick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 提示条 -->
        <Border Grid.Row="1" x:Name="HintBar" Style="{StaticResource Card.Flat}" Padding="14,10" Margin="0,0,0,14"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="HintText" Style="{StaticResource Text.Body}" Margin="9,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 10 个槽位 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SlotList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="14,12" CornerRadius="11"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                                            Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotLabel}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <Grid Grid.Column="1" Width="32" Height="32" Margin="12,0,0,0"
                                          VerticalAlignment="Center">
                                        <Border x:Name="IconTile" CornerRadius="8"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="IconImageTile" CornerRadius="8" Visibility="Collapsed"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Margin="12,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="点选" Style="{StaticResource Button.Base}" Padding="12,5"
                                                Tag="{Binding Slot}" Click="OnRowPick" ToolTip="用十字准星点选窗口" />
                                        <Button Content="切换" Style="{StaticResource Button.Ghost}" Padding="12,5"
                                                Margin="6,0,0,0" Tag="{Binding Slot}" Click="OnActivateSlot" />
                                        <Button Content="清除" Style="{StaticResource Button.Danger}" Padding="12,5"
                                                Margin="6,0,0,0" Tag="{Binding Slot}" Click="OnClearSlot" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="IconImageTile" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
