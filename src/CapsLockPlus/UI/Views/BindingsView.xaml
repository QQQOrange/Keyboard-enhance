<UserControl x:Class="CapsLockPlus.UI.Views.BindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="把窗口钉在 Caps+1 ~ Caps+0 上" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="先切到目标窗口，点「绑定当前窗口」；之后按 Caps+数字 就能立刻切回去。"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="绑定当前前台窗口到 1 号槽" Style="{StaticResource Button.Primary}"
                        Click="OnBindForeground" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SlotList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="14,12" CornerRadius="11"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                                            Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotLabel}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}" Margin="0,0,10,0"
                                                Visibility="{Binding ModeVisibility}">
                                            <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Badge.Text}" />
                                        </Border>
                                        <Button Content="绑定" Style="{StaticResource Button.Base}" Padding="12,5"
                                                Tag="{Binding Slot}" Click="OnBindSlot" />
                                        <Button Content="切换" Style="{StaticResource Button.Ghost}" Padding="12,5"
                                                Margin="6,0,0,0" Tag="{Binding Slot}" Click="OnActivateSlot" />
                                        <Button Content="清除" Style="{StaticResource Button.Danger}" Padding="12,5"
                                                Margin="6,0,0,0" Tag="{Binding Slot}" Click="OnClearSlot" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="1" x:Name="ShowAllButton" Content="显示全部 10 个槽位"
                        Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                        Margin="8,8,0,0" Click="OnShowAll" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
