<UserControl x:Class="CapsLockPlus.UI.Views.LayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="触发键与键盘层" Style="{StaticResource Text.H2}" />
                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="按住触发键超过阈值即进入它绑定的层；短按则保留原键盘功能。&#x0a;每个触发键可绑定不同层，层与层之间按键互不干扰。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：触发键 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="触发键" Style="{StaticResource Text.H3}" />

                    <ListBox Grid.Row="1" x:Name="TriggerList" Background="Transparent" BorderThickness="0"
                             Margin="0,10,0,0" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTriggerSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Keycap}" Padding="10,6">
                                        <TextBlock Text="{Binding KeyLabel}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              Click="OnTriggerEnabledChanged" Tag="{Binding Index}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="＋ 添加触发键" Style="{StaticResource Button.Primary}" Click="OnAddTrigger" />
                        <Button Content="删除" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                                Click="OnDeleteTrigger" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：触发键详情 + 层列表 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 触发键编辑 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="7,0,0,14">
                        <StackPanel>
                            <TextBlock Text="触发键设置" Style="{StaticResource Text.H3}" />
                            <TextBlock x:Name="NoTriggerHint" Text="先在左边选一个触发键" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,8,0,0" />

                            <StackPanel x:Name="TriggerEditor" Visibility="Collapsed">
                                <TextBlock Text="物理键" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}" Padding="12,7" MinWidth="80">
                                        <TextBlock x:Name="TriggerKeyLabel" Text="CapsLock" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Button Content="改键…" Style="{StaticResource Button.Base}" Padding="12,6"
                                            Margin="10,0,0,0" Click="OnChangeTriggerKey"
                                            ToolTip="按一下目标键即可更换触发键" />
                                </StackPanel>

                                <TextBlock Text="绑定到哪一层" Style="{StaticResource Text.Secondary}"
                                           Margin="0,14,0,6" />
                                <ComboBox x:Name="LayerBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnTriggerLayerChanged" />

                                <TextBlock Text="长按阈值（毫秒）" Style="{StaticResource Text.Secondary}"
                                           Margin="0,14,0,6" />
                                <TextBox x:Name="HoldMsBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                         VerticalContentAlignment="Center" TextChanged="OnHoldMsChanged" />
                                <TextBlock Text="按住超过这个时间才进入层；在此之前松开 = 短按，走下面的短按动作。"
                                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="按住触发键时按别的键，立即进层"
                                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                        <TextBlock Text="推荐开启。否则每次按组合键都要先等满上面的阈值，手感会明显发涩。"
                                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="HoldOnOtherBox"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Click="OnHoldOnOtherChanged" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                                <TextBlock Text="短按动作" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                <ComboBox x:Name="TapActionBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnTapActionChanged" MaxDropDownHeight="320" />

                                <TextBlock Text="双击动作（留空 = 关闭双击）" Style="{StaticResource Text.Secondary}"
                                           Margin="0,14,0,6" />
                                <ComboBox x:Name="DoubleTapBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnDoubleTapActionChanged" MaxDropDownHeight="320" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 层列表 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="层（共 10 个）" Style="{StaticResource Text.H3}" />
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="每层的按键绑定在「按键映射」页编辑；从这里跳过去会自动切到对应层。" />
                            <ItemsControl x:Name="LayerList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="10"
                                                Background="{DynamicResource Brush.SurfaceAlt}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                                           VerticalAlignment="Center" Width="30" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="编辑按键" Style="{StaticResource Button.Ghost}"
                                                        Padding="12,5" Tag="{Binding Id}"
                                                        Click="OnEditLayerKeys" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
