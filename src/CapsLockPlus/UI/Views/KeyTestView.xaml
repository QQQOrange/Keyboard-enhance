<UserControl x:Class="CapsLockPlus.UI.Views.KeyTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <UserControl.Resources>
        <!-- 表格默认是系统白底，暗色主题下很突兀，这里跟着主题走 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：实时状态 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="实时状态" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="在这个页面里直接按键即可。按住触发键再按别的键，下面会立刻显示切到了第几层。" />

                    <Border Margin="0,16,0,0" Padding="18,16" CornerRadius="10"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="最近按下的键" Style="{StaticResource Text.Tertiary}" />
                            <TextBlock x:Name="LastKeyText" Text="—" FontSize="30" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock x:Name="LastKeyDetail" Text="按任意键开始测试"
                                       Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,5,0" Padding="12,10" CornerRadius="9"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <StackPanel>
                                <TextBlock Text="键盘钩子" Style="{StaticResource Text.Tertiary}" FontSize="11" />
                                <TextBlock x:Name="HookText" Text="检查中" FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0,5,0" Padding="12,10" CornerRadius="9"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <StackPanel>
                                <TextBlock Text="触发键" Style="{StaticResource Text.Tertiary}" FontSize="11" />
                                <TextBlock x:Name="TriggerText" Text="未按住" FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="5,0,0,0" Padding="12,10" CornerRadius="9"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <StackPanel>
                                <TextBlock Text="当前层" Style="{StaticResource Text.Tertiary}" FontSize="11" />
                                <TextBlock x:Name="LayerText" Text="未进层" FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="HintText" Style="{StaticResource Text.Tertiary}"
                               TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="提示：按住触发键不放，界面会在 200ms 后进入层模式；按住期间按其他键会立刻进层。" />
                </StackPanel>
            </Border>

            <!-- 右：按键流水 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,16"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="按键流水" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="每一行 = 一次真实按键，附带它所在层会执行的动作。只记录真实按键，软件自己注入的不算。" />

                    <ListView x:Name="EventList" Height="392" Margin="0,12,0,0"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="70" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="按键" Width="110" DisplayMemberBinding="{Binding Key}" />
                                <GridViewColumn Header="层" Width="90" DisplayMemberBinding="{Binding Layer}" />
                                <GridViewColumn Header="动作" Width="180" DisplayMemberBinding="{Binding Action}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="清空" Click="OnClear" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="复制诊断信息" Click="OnCopyDiag" Padding="14,6" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Text.Tertiary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
