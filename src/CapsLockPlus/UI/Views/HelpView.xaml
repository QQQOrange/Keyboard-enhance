<UserControl x:Class="CapsLockPlus.UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="按住" Style="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Grid.Column="0" Style="{StaticResource Keycap}" Margin="44,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="Caps" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <TextBlock Grid.Column="1" Text="再看下面的按键 —— 灰色表示没有绑定，可以到「按键映射」里自己加。"
                           Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBox Grid.Column="2" x:Name="FilterBox" Style="{StaticResource TextBox.Base}" Width="220"
                         Height="36" VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                         ToolTip="筛选按键或功能" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,14">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,10,8" Padding="11,9" CornerRadius="10"
                                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource Keycap}" Padding="8,4">
                                                            <TextBlock Text="{Binding Combo}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Accent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Text.Tertiary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
