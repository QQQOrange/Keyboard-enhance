<UserControl x:Class="CapsLockPlus.UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：触发键提示 + 筛选 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T '按住'}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Keycap}" Padding="10,4">
                        <TextBlock x:Name="TriggerKeyText" Text="CapsLock" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="HintText"
                           Text="{loc:T '再看下面的按键 —— 未绑定的键可以到「按键映射」里自己加。'}"
                           Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,0,14,0" />

                <TextBox Grid.Column="2" x:Name="FilterBox" Style="{StaticResource TextBox.Base}" Width="220"
                         MinHeight="36" VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                         ToolTip="{loc:T '筛选按键或功能'}" />
            </Grid>
        </Border>

        <!-- 使用指南（可折叠） -->
        <Expander Grid.Row="1" x:Name="GuideExpander" Margin="0,0,0,12" IsExpanded="False"
                  Foreground="{DynamicResource Brush.TextPrimary}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T '使用指南'}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:T '图层、触发键、子层、宏、窗口绑定…（点开查看）'}"
                               Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
                <StackPanel x:Name="GuidePanel">
                    <!-- 由代码填充，内容跟随实际配置 -->
                </StackPanel>
            </Border>
        </Expander>

        <!-- 快捷键速查表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,14">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,10,8" Padding="11,9" CornerRadius="10"
                                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource Keycap}" Padding="8,4">
                                                            <TextBlock Text="{Binding Combo}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Accent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Text.Tertiary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
