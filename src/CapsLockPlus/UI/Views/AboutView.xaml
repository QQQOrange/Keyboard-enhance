<UserControl x:Class="CapsLockPlus.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,4,20,24"
                  SizeChanged="OnAboutScrollSizeChanged">
        <!--
            全屏时不能再让内容挤在左边一条：以前是 MaxWidth=880 + 左对齐，
            1600 宽的窗口右边会空出 700 多 DIP。
            现在按"左操作 / 右信息"分两列，窗口不够宽时（< 1080）自动退回单列
            —— 判断和重排都在 OnAboutScrollSizeChanged 里，只改 Grid 行列。
        -->
        <Grid x:Name="AboutGrid" MaxWidth="1320" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 3:2 而不是 1:1：左列的更新卡里有"令牌行"（标签 + 输入框 + 四个按钮），
                 等分时 540 宽放不下，令牌输入框会被压到只剩 80 多 —— 看不见自己填了什么。
                 3:2 时左列 700+，令牌框还能留 300 宽。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌卡（横跨两列，本身就是一条通栏） -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" CornerRadius="18" Padding="26,24" Margin="0,0,0,16">
                <Border.Background>
                    <!-- 与引导页、帮助页同一块品牌渐变（Controls.xaml / Brush.BrandHero） -->
                    <StaticResource ResourceKey="Brush.BrandHero" />
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 与侧栏、exe 用同一张应用图标。
                         图标自己的蓝底和这条蓝色横幅撞色，加一圈很淡的白边把轮廓勾出来。 -->
                    <Border Grid.Column="0" CornerRadius="16" BorderThickness="1"
                            BorderBrush="{StaticResource Brush.BrandHairline}" VerticalAlignment="Center">
                        <Image Width="64" Height="64"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/app.png" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="按键增强" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                            <Border CornerRadius="6" Background="{StaticResource Brush.BrandHairline}" Padding="8,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadge" Text="v1.0.0" FontSize="12" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Keyboard Enhance · 让每一个按键都能变成你的快捷键" Foreground="{StaticResource Brush.BrandSubtitle}" FontSize="13.5"
                                   Margin="0,7,0,0" />
                        <TextBlock x:Name="BuildInfo" Foreground="{StaticResource Brush.BrandAccent}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="GitHubButton" Style="{StaticResource Button.Base}"
                            Background="{StaticResource Brush.BrandOnLight}" BorderBrush="{StaticResource Brush.BrandOnLight}"
                            Foreground="{StaticResource Brush.BrandOnLightText}" FontWeight="SemiBold"
                            Padding="16,9" VerticalAlignment="Center" Click="OnOpenGitHub"
                            ToolTip="在浏览器中打开项目主页">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="GitHub" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 更新卡：左列（操作区） -->
            <Border Grid.Row="1" Grid.Column="0" x:Name="UpdateCard" Style="{StaticResource Card}"
                    Margin="0,0,8,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="自动更新" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="每次启动时静默检查，有新版本会先询问再下载"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AutoUpdateBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnAutoUpdateChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- GitHub 个人访问令牌：解除更新检查的接口限流 -->
                    <StackPanel Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GitHub 个人访问令牌" Style="{StaticResource Text.Body}"
                                           VerticalAlignment="Center" />
                                <!-- 问号按钮：点开 GitHub 官方文档（新标签页）。
                                     用 Button 而不是图片图标：它天生能 Tab 到、能用
                                     空格/回车触发，读屏软件也念得出（AutomationProperties）。
                                     字形用文字 "?" 而不是图标字体 —— E 系列字形在部分
                                     Win10 的 Fluent Icons 里是空白方框。 -->
                                <Button x:Name="TokenHelpButton" Content="?"
                                        Style="{StaticResource Button.Ghost}"
                                        Width="22" Height="22" MinWidth="0" Padding="0"
                                        Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                        VerticalAlignment="Center" Click="OnOpenTokenHelp"
                                        AutomationProperties.Name="什么是 GitHub 个人访问令牌（打开官方帮助）"
                                        AutomationProperties.HelpText="在浏览器中打开 GitHub 官方中文文档：管理个人访问令牌">
                                    <Button.ToolTip>
                                        <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                   Text="个人访问令牌（PAT）相当于给程序用的专用密码：填了之后，本程序以你的账号身份调用 GitHub 接口，配额从每小时 60 次提到 5000 次，还能一键自动下载更新。只读公开仓库不需要勾任何权限。&#x0a;&#x0a;点这个问号，在浏览器里打开 GitHub 官方说明（含创建步骤）。" />
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>

                            <!-- 已保存时这里显示一串圆点（固定 8 个，不暴露真实长度）。
                                 一旦开始输入/粘贴，圆点会被清掉换成新令牌 —— 见 OnTokenBoxPreviewTextInput。 -->
                            <TextBox Grid.Column="1" x:Name="TokenBox" Margin="12,0,0,0"
                                     Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     VerticalContentAlignment="Center"
                                     GotKeyboardFocus="OnTokenBoxGotFocus"
                                     PreviewTextInput="OnTokenBoxPreviewTextInput"
                                     DataObject.Pasting="OnTokenBoxPasting"
                                     ToolTip="已保存时显示为圆点；直接输入或粘贴新令牌就会替换掉旧的" />

                            <!-- 验证：拿这个令牌真请求一次 GitHub，确认它可用，并显示配额。
                                 先验证再保存，比"存进去之后检查更新才发现是错的"省事得多。 -->
                            <Button Grid.Column="2" x:Name="VerifyTokenButton" Content="验证"
                                    Style="{StaticResource Button.Base}" Padding="14,6" Margin="8,0,0,0"
                                    Click="OnVerifyToken"
                                    ToolTip="用这个令牌请求一次 GitHub，确认真能用（顺便显示剩余配额）" />
                            <Button Grid.Column="3" x:Name="SaveTokenButton" Content="保存"
                                    Style="{StaticResource Button.Primary}" Padding="14,6" Margin="6,0,0,0"
                                    Click="OnSaveToken" />
                            <Button Grid.Column="4" x:Name="ClearTokenButton" Content="清除"
                                    Style="{StaticResource Button.Ghost}" Padding="12,6" Margin="6,0,0,0"
                                    Click="OnClearToken" />
                            <Button Grid.Column="5" Content="去创建" Style="{StaticResource Button.Ghost}"
                                    Padding="12,6" Margin="6,0,0,0" Click="OnOpenTokenPage"
                                    ToolTip="打开 GitHub 的令牌管理页（只需勾选 Public repositories 只读）" />
                        </Grid>

                        <TextBlock x:Name="TokenStatusText" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <!-- 配额：本小时已用多少 / 总共多少。匿名也能读（那就是 60/小时），
                             所以没填令牌时这行同样有内容，用户能直观看到差别。 -->
                        <TextBlock x:Name="TokenUsageText" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前版本" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="CurrentVersionText" Text="1.0.0"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource Button.Base}"
                                    Padding="16,7" Click="OnCheckUpdate" />
                            <Button x:Name="DownloadButton" Content="下载并安装" Style="{StaticResource Button.Primary}"
                                    Padding="16,7" Margin="8,0,0,0" Visibility="Collapsed"
                                    Click="OnDownloadInstall" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0" Visibility="Collapsed"
                                 Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.Accent}"
                                 Background="{DynamicResource Brush.SurfaceAlt}" BorderThickness="0" />

                    <Border x:Name="StatusCard" Style="{StaticResource Card.Flat}" Margin="0,14,0,0"
                            Padding="14,11" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="160" />

                            <!-- 没填令牌时：这里给下载地址，而且**只能**点它去浏览器下载。
                                 「下载并安装」会被整个藏起来 —— 程序内不提供下载入口，
                                 用户必须自己确认过下载地址再动手。 -->
                            <StackPanel x:Name="ManualLinkPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                           Text="没有填写 GitHub 个人访问令牌，所以只能提示、不能自动下载。点下面的地址用浏览器下载：" />
                                <Button x:Name="UpdateLinkButton" Style="{StaticResource Button.Ghost}"
                                        Padding="0" Margin="0,5,0,0" HorizontalAlignment="Left" Cursor="Hand"
                                        Click="OnOpenUpdateLink"
                                        ToolTip="在默认浏览器里打开发布页（新标签页）"
                                        AutomationProperties.Name="在浏览器中打开这个版本的 GitHub 下载地址"
                                        AutomationProperties.HelpText="打开浏览器下载新版本">
                                    <TextBlock x:Name="UpdateLinkText" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右列（信息区）：信息卡 + 致谢卡竖着叠 -->
            <StackPanel x:Name="AboutRightColumn" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                        VerticalAlignment="Top">

            <!-- 信息卡 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource Text.H2}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" x:Name="AboutVersion" Style="{StaticResource Text.Body}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="项目主页" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" x:Name="AboutGitHubLink" Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.Accent}" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis" MouseLeftButtonUp="OnOpenGitHub"
                                   ToolTip="点击在浏览器中打开" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上游项目" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Accent}"
                                   Cursor="Hand" Text="wo52616111/capslock-plus（AutoHotkey 原版）"
                                   MouseLeftButtonUp="OnOpenUpstream" ToolTip="点击在浏览器中打开" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开源协议" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="GPL-3.0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="设置文件" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" x:Name="AboutDataPath" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 致谢 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于这个程序" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                               Text="按键增强（Keyboard Enhance）是一个 Windows 键盘增强工具：按住一个触发键进入功能层，就能把任意按键变成快捷键 —— 光标移动、文字选择、窗口切换、打开网页、播放宏，全部可以自己配。" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="支持 10 个独立图层，每层可以有自己的触发键和整套按键绑定。所有配置都在图形界面里完成，也支持 WebDAV 同步与导入导出。" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="本程序的按键语义源自 Junkai Chen 的 AutoHotkey 版 CapsLock+，界面、引擎与全部设置系统为重新实现。" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
