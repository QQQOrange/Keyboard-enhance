<UserControl x:Class="CapsLockPlus.UI.Views.HotstringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
             FontFamily="{StaticResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,4,20,24">

            <!-- ① 顶部说明 + 触发设置 -->
            <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T '打一小段触发词，自动变成一大段文字'}" Style="{StaticResource Text.H3}" />
                            <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="{loc:T '打完触发词再按空格就替换（也可以关掉，改用 Caps+Tab 展开）。前缀符号只有一个，可以自己改。'}" />
                        </StackPanel>
                    </Grid>

                    <!-- 触发设置 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:T '前缀符号'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                            <TextBox x:Name="PrefixBox" Width="86" MaxLength="1"
                                     Style="{StaticResource TextBox.Base}"
                                     TextChanged="OnPrefixChanged"
                                     ToolTip="{loc:T '只认这一个符号；留空表示不需要前缀，直接打触发词'}" />
                        </StackPanel>

                        <CheckBox Grid.Column="1" x:Name="FullWidthBox" Margin="0,22,20,0"
                                  Content="{loc:T '用全角符号'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '勾上后 / 会按 ／ 处理（中文输入法下就是这个）'}" />

                        <CheckBox Grid.Column="2" x:Name="SpaceBox" Margin="0,22,20,0"
                                  Content="{loc:T '空格触发'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '打完触发词按空格就替换；关掉则只认 Caps+Tab'}" />

                        <CheckBox Grid.Column="3" x:Name="SwallowBox" Margin="0,22,20,0"
                                  Content="{loc:T '吞掉那个空格'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '替换后不再多出一个空格'}" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <CheckBox x:Name="NoteFirstBox" Content="{loc:T '列表优先显示备注'}"
                                      Click="OnOptionsChanged"
                                      ToolTip="{loc:T '备注就是列表里显示的名字；没写备注才显示触发词'}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ② 列表 + 编辑 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T '全部片段'}" Style="{StaticResource Text.H3}" />
                                <TextBlock x:Name="CountText" Text="" Style="{StaticResource Text.Tertiary}"
                                           Margin="8,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="FilterBox" Width="170" Margin="0,0,8,0"
                                     Style="{StaticResource TextBox.Base}"
                                     TextChanged="OnFilterChanged"
                                     ToolTip="{loc:T '按触发词 / 备注 / 内容过滤'}" />
                            <Button Grid.Column="2" Content="{loc:T '新增'}" Style="{StaticResource Button.Primary}"
                                    Padding="14,6" Margin="0,0,8,0" Click="OnAddClick" />
                            <Button Grid.Column="3" x:Name="DeleteButton" Content="{loc:T '删除'}"
                                    Style="{StaticResource Button.Danger}" Padding="14,6" Click="OnDeleteClick" />
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="EntryList" Background="Transparent" BorderThickness="0"
                                 Margin="10,0,10,12" SelectionChanged="OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,5" Width="Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="KeyText" Text="{Binding KeyLabel}" FontSize="12.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Preview}" Margin="10,0,0,0"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding GroupLabel}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="10,0,4,0"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T '编辑片段'}" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T '触发词'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                        <TextBox x:Name="KeyBox" Style="{StaticResource TextBox.Base}"
                                 TextChanged="OnEditorChanged"
                                 ToolTip="{loc:T '打完它再按空格就替换；只用字母/数字/符号'}" />

                        <TextBlock Text="{loc:T '替换成'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                        <TextBox x:Name="ValueBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource TextBox.Base}"
                                 TextChanged="OnEditorChanged" />

                        <TextBlock Text="{loc:T '备注（列表里显示它）'}" Style="{StaticResource Text.Secondary}"
                                   Margin="0,12,0,6" />
                        <TextBox x:Name="CommentBox" Style="{StaticResource TextBox.Base}"
                                 TextChanged="OnEditorChanged" />

                        <TextBlock Text="{loc:T '分组'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                        <ComboBox x:Name="GroupBox" IsEditable="True" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnEditorChanged"
                                  ToolTip="{loc:T '可以选已有分组，也可以直接输入新名字'}" />

                        <CheckBox x:Name="EnabledBox" Content="{loc:T '启用这个片段'}" Margin="0,14,0,0"
                                  Click="OnEditorChanged" />

                        <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
