<UserControl x:Class="CapsLockPlus.UI.Views.HotstringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ① 页头：和 Qbar / 按键映射同一套版式（图标 + 标题 + 说明） -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="0">
                    <TextBlock Style="{StaticResource Text.H2}" Text="{loc:T '打一个别名，自动变成一大段文字'}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{loc:T '打完别名再按空格就替换（也可以关掉，改用 Caps+Tab 展开）。前缀符号只有一个，可以自己改。'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ② 别名设置：标签在上、控件在下，和设置页一致 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T '别名设置'}" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="AuditButton" Content="{loc:T '体检'}"
                            Style="{StaticResource Button.Ghost}" Padding="9,4" Margin="10,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Click="OnAuditClick"
                            ToolTip="{loc:T '检查重复触发词、空内容、前缀不对、分组未登记等问题'}" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '前缀符号'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                        <TextBox x:Name="PrefixBox" Width="88" MaxLength="1" MinHeight="34"
                                 VerticalContentAlignment="Center" Style="{StaticResource TextBox.Base}"
                                 TextChanged="OnPrefixChanged"
                                 ToolTip="{loc:T '只认这一个符号；留空表示不需要前缀，直接打别名'}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '符号形态'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <CheckBox x:Name="FullWidthBox" Content="{loc:T '用全角符号'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '勾上后 / 会按 ／ 处理（中文输入法下就是这个）'}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '展开方式'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <CheckBox x:Name="SpaceBox" Content="{loc:T '空格展开'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '打完别名按空格就替换；关掉则只认 Caps+Tab'}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '空格处理'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <CheckBox x:Name="SwallowBox" Content="{loc:T '吞掉那个空格'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '替换后不再多出一个空格'}" />
                    </StackPanel>

                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{loc:T '列表显示'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <TextBlock Text="{loc:T '只显示备注（替换内容不显示）'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ③ 主体：左分组 / 中列表 / 右编辑 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 分组 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '分组'}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{loc:T '筛选 · 拖动排序'}" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                        </StackPanel>
                        <Button Grid.Column="1" x:Name="NewGroupButton" Content="+"
                                Style="{StaticResource Button.Ghost}" Padding="8,2" FontSize="15"
                                VerticalAlignment="Top" Click="OnNewGroupClick"
                                ToolTip="{loc:T '新建分组（也可以右键列表里的别名「移到分组」）'}"
                                AutomationProperties.Name="{loc:T '新建分组'}" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="GroupList" Background="Transparent" BorderThickness="0"
                             Margin="10,6,10,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnGroupChanged"
                             ContextMenuOpening="OnGroupContextMenuOpening"
                             AllowDrop="True"
                             PreviewKeyDown="OnGroupListKeyDown"
                             DragEnter="OnGroupDragOver" DragOver="OnGroupDragOver"
                             DragLeave="OnGroupDragLeave" Drop="OnGroupDrop">
                        <!-- 菜单挂在**每个列表项**上：WPF 只有在事件源元素自己带 ContextMenu 时才会
                             抛 ContextMenuOpening 并打开菜单；挂在 ListBox 上是不会冒泡触发的。 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 左侧的抓手只是"可以拖"的视觉提示，真正的拖动面是覆盖整行的透明 Thumb。 -->
                                    <TextBlock Grid.Column="0" Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Center" Margin="6,0,2,0" />

                                    <TextBlock Grid.Column="1" Text="&#xE8B7;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Center" Margin="2,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />

                                    <!-- 覆盖整行的透明拖动面：按在分组名的任意位置都能上下拖。 -->
                                    <Thumb Grid.ColumnSpan="3" Background="Transparent" Opacity="0"
                                           Cursor="SizeAll"
                                           AutomationProperties.Name="{loc:T '拖动排序'}"
                                           DragStarted="OnGroupThumbDragStarted"
                                           DragCompleted="OnGroupThumbDragCompleted"
                                           ToolTip="{loc:T '按住拖动可调整分组顺序'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部操作条：选中分组后可直接改名 / 删除（和右侧列表的操作条同一套版式） -->
                    <!-- 底部操作条：三等分，宽度固定，避免最后一个按钮被卡片边缘裁掉。 -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="10,0,10,12">
                        <Button x:Name="RenameGroupButton" Content="{loc:T '重命名'}"
                                Style="{StaticResource Button.Base}" Padding="4,5" FontSize="12"
                                Margin="0,0,4,0" IsEnabled="False" Click="OnRenameGroupClick" />
                        <Button x:Name="DeleteGroupButton" Content="{loc:T '删除'}"
                                Style="{StaticResource Button.Danger}" Padding="4,5" FontSize="12"
                                Margin="2,0,2,0" IsEnabled="False" Click="OnDeleteGroupClick" />
                        <Button x:Name="ExportGroupButton" Content="{loc:T '导出'}"
                                Style="{StaticResource Button.Ghost}" Padding="4,5" FontSize="12"
                                Margin="4,0,0,0" Click="OnExportGroupClick"
                                ToolTip="{loc:T '只导出当前分组的别名；选「全部」时导出全部'}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 列表 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{loc:T '全部别名'}" Style="{StaticResource Text.H3}"
                                   VerticalAlignment="Center" />

                        <!-- 单行：搜索框自适应（最小 180），筛选/排序/计数靠右。
                             用 Grid 而不是 StackPanel —— 右侧控件按内容定宽，搜索框吃掉剩余空间。 -->
                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />

                            <TextBox Grid.Column="1" x:Name="FilterBox" Style="{StaticResource TextBox.Base}"
                                     KeyDown="OnFilterKeyDown" MinHeight="34" MinWidth="180"
                                     VerticalContentAlignment="Center" TextChanged="OnFilterChanged" />

                            <CheckBox Grid.Column="2" x:Name="UnusedOnlyBox" Content="{loc:T '从未使用'}"
                                      VerticalAlignment="Center" Margin="12,0,12,0"
                                      Click="OnUnusedOnlyChanged"
                                      ToolTip="{loc:T '只显示还没被展开过的别名'}" />

                            <ComboBox Grid.Column="3" x:Name="SortBox" Style="{StaticResource ComboBox.Base}"
                                      Width="150" MinWidth="150" VerticalAlignment="Center"
                                      SelectionChanged="OnSortChanged"
                                      ToolTip="{loc:T '列表排序方式'}" />

                            <TextBlock Grid.Column="4" x:Name="FilterCount" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="52"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="EmptyHint" Text="{loc:T '还没有别名。点下面的「新增」建一条。'}"
                                   Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap"
                                   MaxWidth="260" TextAlignment="Center" />
                        <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                                 Margin="0,0,0,4" SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSelectionChanged"
                                 ContextMenuOpening="OnEntryContextMenuOpening"
                                 PreviewMouseLeftButtonDown="OnEntryMouseDown"
                                 PreviewMouseMove="OnEntryMouseMove"
                                   AllowDrop="True" DragOver="OnEntryListDragOver" Drop="OnEntryListDrop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Opacity="{Binding Opacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 最左边：当前前缀符号（跟着设置里的前缀一起变）。 -->
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                                                Margin="0,0,8,0" VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.AccentSoft}"
                                                ToolTip="{loc:T '当前前缀符号'}">
                                            <TextBlock Text="{Binding PrefixLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding KeyLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Preview}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,8,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding GroupLabel}" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Tertiary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding UsageLabel}" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"
                                                   MinWidth="34" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8,16,14">
                        <Button Content="{loc:T '新增'}" Style="{StaticResource Button.Primary}" Click="OnAddClick" />
                        <Button x:Name="DeleteButton" Content="{loc:T '删除'}" Style="{StaticResource Button.Danger}"
                                Margin="8,0,0,0" Click="OnDeleteClick" />
                        <Button x:Name="MoveButton" Content="{loc:T '移到分组'}" Style="{StaticResource Button.Ghost}"
                                Margin="8,0,0,0" Click="OnMoveClick" IsEnabled="False"
                                ToolTip="{loc:T '把选中的别名放到某个分组里（也可以直接把别名拖到左侧分组上）'}" />
                        <Button x:Name="ImportButton" Content="{loc:T '导入'}" Style="{StaticResource Button.Ghost}"
                                Margin="8,0,0,0" Click="OnImportClick"
                                ToolTip="{loc:T '从 JSON 文件导入别名（合并，不会删掉已有的）'}" />
                        <Button x:Name="CleanupButton" Content="{loc:T '清理未使用'}" Style="{StaticResource Button.Ghost}"
                                Margin="8,0,0,0" Click="OnCleanupClick" Visibility="Collapsed"
                                ToolTip="{loc:T '删除所有从未展开过的别名（会先确认）'}" />
                        <Button x:Name="ExportButton" Content="{loc:T '导出'}" Style="{StaticResource Button.Ghost}"
                                Margin="6,0,0,0" Click="OnExportClick"
                                ToolTip="{loc:T '把全部别名导出成 JSON，换机器时用得上'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="330"
                                   Text="{loc:T '别名不显示前缀符号；保存时会自动补回去。右键条目可以复制或移到分组。'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 编辑（没选片段时整栏隐藏） -->
            <Border Grid.Column="2" x:Name="EditorCard" Style="{StaticResource Card}" Padding="18,16"
                    Width="360" Margin="12,0,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{loc:T '编辑别名'}" Style="{StaticResource Text.H3}" />
                    <TextBlock x:Name="EditTitle" Text="" Style="{StaticResource Text.Tertiary}"
                               Margin="0,5,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="{loc:T '别名'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                    <TextBox x:Name="KeyBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnEditorChanged"
                             ToolTip="{loc:T '打完它再按空格就替换；只用字母/数字/符号'}" />

                    <TextBlock Text="{loc:T '替换成'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                    <TextBox x:Name="ValueBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Base}"
                             TextChanged="OnEditorChanged" />

                    <TextBlock Text="{loc:T '备注（鼠标停在列表左侧图标上即可看到）'}" Style="{StaticResource Text.Secondary}"
                               Margin="0,12,0,6" />
                    <TextBox x:Name="CommentBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnEditorChanged" />

                    <TextBlock Text="{loc:T '只在这些程序里展开（可选）'}" Style="{StaticResource Text.Secondary}"
                               Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="AppsBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnEditorChanged"
                                 ToolTip="{loc:T '进程名，逗号分隔，例如 code.exe, notepad.exe；留空 = 所有程序'}" />

                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}"
                                Content="{loc:T '选择程序…'}" Margin="6,0,0,0" Click="OnPickAppFile"
                                ToolTip="{loc:T '从文件管理器里挑一个 exe'}" />

                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE7C9;"
                                Click="OnPickAppWindow" Margin="2,0,0,0"
                                AutomationProperties.Name="{loc:T '点窗口选取程序'}"
                                ToolTip="{loc:T '点一下，然后在目标程序窗口上点一下就能选中它'}" />
                    </Grid>

                    <TextBlock Text="{loc:T '分组'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 用 TextBox 而不是可编辑 ComboBox：下拉框在失焦时会把用户手打的新组名
                             还原成"选中的那一项"，这正是"分组改不了"的来源。 -->
                        <TextBox Grid.Column="0" x:Name="GroupBox" Style="{StaticResource TextBox.Base}"
                                 MinHeight="36" VerticalContentAlignment="Center"
                                 TextChanged="OnEditorChanged"
                                 ToolTip="{loc:T '可以直接输入新组名；也可以点右边的「选择…」从已有分组里挑'}" />

                        <Button Grid.Column="1" Content="{loc:T '选择…'}" Style="{StaticResource Button.Base}"
                                Padding="9,5" Margin="6,0,0,0" Click="OnPickGroupClick"
                                ToolTip="{loc:T '从现有分组里选一个'}" />
                        <Button Grid.Column="2" Content="{loc:T '新建…'}" Style="{StaticResource Button.Base}"
                                Padding="9,5" Margin="6,0,0,0" Click="OnNewGroupClick"
                                ToolTip="{loc:T '新建一个分组'}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="{loc:T '换一个分组 = 把这条别名移过去；也可以把列表里的别名直接拖到左边的分组上。'}" />

                    <TextBlock x:Name="UsageText" Style="{StaticResource Text.Tertiary}"
                               Margin="0,8,0,0" Text="" />

                    <!-- 分组选择弹层 -->
                    <Popup x:Name="GroupPicker" StaysOpen="False" AllowsTransparency="True"
                           Placement="Bottom" PlacementTarget="{Binding ElementName=GroupBox}">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="10" Padding="5" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.32" Color="#000000" />
                            </Border.Effect>
                            <StackPanel MinWidth="180">
                                <TextBlock Text="{loc:T '选一个分组'}" Style="{StaticResource Text.Tertiary}"
                                           Margin="9,6,9,4" />
                                <ListBox x:Name="GroupPickerList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource RowItem}" MaxHeight="220"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="OnGroupPickerPicked" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <CheckBox x:Name="EnabledBox" Content="{loc:T '启用这个别名'}" Margin="0,14,0,0"
                              Click="OnEditorChanged" />

                    <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Tertiary}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
