<UserControl x:Class="CapsLockPlus.UI.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="布局方案" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <ComboBox x:Name="SchemeBox" Style="{StaticResource ComboBox.Base}" Width="212"
                              SelectionChanged="OnSchemeChanged">
                        <ComboBoxItem Content="Capslox（3.0 之后，推荐）" Tag="capslox" />
                        <ComboBoxItem Content="经典 CapsLock+ 3.0 之前" Tag="capslock_plus" />
                    </ComboBox>
                </StackPanel>

                <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextBox.Base}"
                         Margin="16,0,16,0" MinHeight="36" VerticalContentAlignment="Center"
                         TextChanged="OnSearchChanged" ToolTip="搜索按键或功能，例如 q、F2、剪贴板" />

                <Button Grid.Column="2" Content="恢复默认" Style="{StaticResource Button.Base}"
                        Click="OnResetClick" />
            </Grid>
        </Border>

        <!-- 主体：左键盘 + 右编辑 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 键盘 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock Text="按住 CapsLock" Style="{StaticResource Badge.Text}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <TextBlock Text="+ 下面的键" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="7,0,0,0" />
                            <TextBlock x:Name="LayerHint" Text="当前：基础层" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.AccentSoft}"
                                     Stroke="{DynamicResource Brush.AccentSoftBorder}" StrokeThickness="1"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="已绑定" Style="{StaticResource Text.Tertiary}" Margin="6,0,14,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Keycap}"
                                     Stroke="{DynamicResource Brush.KeycapBorder}" StrokeThickness="1"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="未绑定" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" x:Name="KeyboardPanel" VerticalAlignment="Top" Margin="0,4,0,0" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="层" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LayerBox" Style="{StaticResource ComboBox.Base}" Width="260"
                                      SelectionChanged="OnLayerChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="层内修饰键" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="直接按" x:Name="LayerBase" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Margin="0,0,5,0" Click="OnLayerBase"
                                    ToolTip="进入层后直接按的键（Caps + 键）" />
                            <Button Content="+ Ctrl" x:Name="LayerCtrl" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Margin="0,0,5,0" Click="OnLayerCtrl"
                                    ToolTip="进入层后再按住 Ctrl 按的键（Caps + Ctrl + 键）" />
                            <Button Content="+ Shift" x:Name="LayerShift" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Margin="0,0,5,0" Click="OnLayerShift"
                                    ToolTip="进入层后再按住 Shift 按的键（Caps + Shift + 键）" />
                            <Button Content="+ LAlt" x:Name="LayerAlt" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Margin="0,0,5,0" Click="OnLayerAlt"
                                    ToolTip="进入层后再按住左 Alt 按的键" />
                            <Button Content="+ Win" x:Name="LayerWin" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Click="OnLayerWin"
                                    ToolTip="进入层后再按住 Win 按的键" />
                        </StackPanel>
                        <TextBlock x:Name="CountText" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />

                        <!-- 颜色图例：不看文字也知道深蓝=已绑定 -->
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Border Width="13" Height="13" CornerRadius="3"
                                    Background="{DynamicResource Brush.Accent}"
                                    BorderBrush="{DynamicResource Brush.AccentHover}" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="已绑定功能" Style="{StaticResource Text.Tertiary}"
                                       Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Border Width="13" Height="13" CornerRadius="3"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="未绑定" Style="{StaticResource Text.Tertiary}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 编辑面板 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="编辑绑定" Style="{StaticResource Text.H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource Keycap}" Padding="12,7">
                                <TextBlock Text="Caps" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="4,0,4,0"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                            <Border x:Name="EditKeycap" Style="{StaticResource Keycap}" Padding="12,7">
                                <TextBlock x:Name="EditKeyLabel" Text="Q" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>

                            <!-- 自定义按键：键盘上没有的键也能绑 -->
                            <Button Content="自定义按键…" Style="{StaticResource Button.Base}"
                                    Padding="12,6" Margin="14,0,0,0" Click="OnCustomKeyClick"
                                    ToolTip="绑定键盘上不存在的键（例如小键盘、媒体键、浏览器键等）" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <!-- ================= 普通分类：分类 + 功能 两级下拉 ================= -->
                        <Grid x:Name="NormalActionPicker">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="功能" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <ComboBox x:Name="ActionBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnActionChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                        </Grid>

                        <!-- ================= 窗口绑定：只有分类 + 两个按钮 =================
                             选了「窗口绑定」分类后，这里不再有"功能"下拉 ——
                             因为"绑哪个窗口"不是从列表里选，而是去抓。

                             两个入口对应两种真实场景：
                               · 点选窗口  → 程序已经开着，鼠标变准星点一下那个窗口即可
                               · 选择程序  → 知道装在哪 / 还没运行，从资源管理器挑 exe
                        -->
                        <StackPanel x:Name="WinBindPicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxWinBind" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock Text="绑定方式" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PickWindowButton" Style="{StaticResource Button.Primary}"
                                        Padding="16,9" Click="OnPickWindowClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="点选窗口" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PickExeButton" Style="{StaticResource Button.Base}"
                                        Padding="16,9" Margin="10,0,0,0" Click="OnPickExeClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="选择程序文件" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="点选窗口：鼠标变成准星，点哪个窗口就绑哪个程序。&#x0a;选择程序文件：从资源管理器挑一个 exe（程序没在运行也能绑）。" />
                        </StackPanel>

                        <!-- ================= 直达网页：网址 + 备注 =================
                             同样不显示"功能"下拉 —— 选了「直达网页」分类后，
                             要填的就是这两样东西。
                        -->
                        <StackPanel x:Name="WebPagePicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxWeb" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock Text="网址" Style="{StaticResource Text.Secondary}" Margin="0,14,0,7" />
                            <TextBox x:Name="WebUrlBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                     VerticalContentAlignment="Center" TextChanged="OnWebUrlChanged"
                                     ToolTip="例如 https://github.com；不带 http 也会自动补全" />

                            <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                       Margin="0,12,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WebNoteBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="36" VerticalContentAlignment="Center"
                                         TextChanged="OnWebNoteChanged"
                                         ToolTip="给这个网址起个好记的名字，会显示在键帽上" />
                                <Button Grid.Column="1" x:Name="FetchTitleButton" Content="重新取标题"
                                        Style="{StaticResource Button.Base}" Padding="12,6" Margin="8,0,0,0"
                                        Click="OnFetchTitleClick"
                                        ToolTip="再抓一次那个网页的标题" />
                            </Grid>
                            <TextBlock x:Name="WebFetchStatus" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="填完网址会自动抓取网页标题作为备注，不满意可以直接改。备注会显示在键帽上，切到这一层就能看到。" />
                        </StackPanel>

                        <TextBlock x:Name="ActionDesc" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <!--
                            就地状态提示。
                            之前绑定成功后只弹右下角 toast，用户正盯着主窗口根本注意不到，
                            感觉像"没提示"。这里直接在编辑区里显示一行结果。
                        -->
                        <Border x:Name="BindStatusBar" Margin="0,10,0,0" Padding="11,8" CornerRadius="8"
                                Visibility="Collapsed">
                            <TextBlock x:Name="BindStatusText" FontSize="12" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- ============ 已绑定的程序（窗口绑定专用） ============ -->
                        <Border x:Name="WinBindPanel" Margin="0,14,0,0" Padding="14,12" CornerRadius="11"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="当前绑定" Style="{StaticResource Text.Secondary}"
                                           Margin="0,0,0,8" />

                                <!-- 已选中的程序：图标 + 名字 + 路径 -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image x:Name="WinBindIcon" Stretch="Uniform" Margin="4" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WinBindName" Text="还没选择" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="WinBindPath" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="WinBindClearButton" Content="清除"
                                            Style="{StaticResource Button.Ghost}" Padding="10,5"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            Click="OnWinBindClear" />
                                </Grid>

                                <!-- 自定义显示名：exe 名不一定是软件名（如 idea64.exe 其实是 IDEA） -->
                                <TextBlock Text="显示名称（可选）" Style="{StaticResource Text.Secondary}"
                                           Margin="0,12,0,7" />
                                <TextBox x:Name="WinBindNoteBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="34" VerticalContentAlignment="Center"
                                         TextChanged="OnWinBindNoteChanged"
                                         ToolTip="留空则用程序文件名。可以改成你认得的名字，会显示在键帽上" />

                                <TextBlock x:Name="WinBindHint" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- ============ 普通参数面板 ============ -->
                        <StackPanel x:Name="ArgPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ArgLabel" Text="参数" Style="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,7" />
                            <TextBox x:Name="ArgBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="36" VerticalContentAlignment="Center"
                                     TextChanged="OnArgChanged" />
                            <TextBlock x:Name="ArgHint" Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="本层已绑定" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8" />
                    </StackPanel>

                    <ListBox Grid.Row="3" x:Name="BoundList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnBoundSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Keycap}" Padding="7,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12.5" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="清除绑定" Style="{StaticResource Button.Danger}" Padding="12,6"
                                Click="OnClearClick" />
                        <Button Content="测试一下" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                Padding="12,6" Click="OnTestClick" ToolTip="执行一次这个功能（可能影响当前窗口）" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
