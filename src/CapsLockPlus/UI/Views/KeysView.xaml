<UserControl x:Class="CapsLockPlus.UI.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 布局方案固定为新版（Capslox），不再提供切换 —— 旧方案
                     只是历史兼容，留着下拉只会让人误以为要选一个。
                     旁边那个搜索框也移除了：它原本用于过滤按键，
                     但实际使用中几乎没人用，反而占掉一行空间。 -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                           Text="点击键盘上任意键即可编辑它的功能，修改立即生效" />

                <Button Grid.Column="1" Content="恢复默认" Style="{StaticResource Button.Base}"
                        Margin="16,0,0,0" Click="OnResetClick" />
            </Grid>
        </Border>

        <!--
            主体：键盘在上、编辑绑定在下，自上而下排成一列。

            为什么不再左右分栏：右边那栏固定 330 宽，等于从键盘嘴里抢走
            344 DIP（面板 330 + 间距 14）。108 键键盘「大」档要 1058 DIP，
            分栏时窗口得 1716 宽才装得下；合成一列后 1393 就够 ——
            同一块屏幕能选到更大的档位，键帽上的字也更大。

            整页放在一个纵向 ScrollViewer 里：键盘尺寸由档位固定，
            多出来的高度给下面的编辑区；窗口太矮时整页往下滚，
            而不是把键盘压扁（那正是之前"字小到看不清"的根因）。
        -->
        <ScrollViewer Grid.Row="1" x:Name="PageScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False"
                      PanningMode="VerticalOnly"
                      SizeChanged="OnPageScrollSizeChanged">
            <StackPanel>

            <!-- 键盘 -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <!--
                    三段结构（从上到下）：
                      ① 信息条   —— 触发键 / 当前层 / 键盘大小选择
                      ② 键盘     —— 尺寸由**档位**决定，不跟窗口变（见 ApplyKeyboardSize）
                      ③ 控制条   —— 层、层内修饰键、计数、图例

                    键盘下方不再放「本层已绑定」清单：键帽本身就是最直接的
                    状态显示（已绑定深蓝实底、未绑定浅底），再列一遍是重复信息，
                    还把键盘挤小了。这块空间现在让给键盘和编辑区。

                    ⚠ ② 必须是 Auto（不是 *）：Viewbox 已有显式宽高，
                    给它 * 只会让它把键盘再拉伸一次，档位就失准了。
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ① 信息条 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                这里是**当前层的触发键**，不是写死的 CapsLock。
                                不同层可以配不同的触发键（F13、右 Alt、甚至可以组合），
                                写死大写键会让切到第 2 层后提示与实际完全对不上。
                            -->
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock x:Name="TriggerKeyBadge" Text="按住 CapsLock"
                                           Style="{StaticResource Badge.Text}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <TextBlock x:Name="TriggerKeySuffix" Text="+ 下面的键"
                                       Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="7,0,0,0" />
                            <TextBlock x:Name="LayerHint" Text="当前：基础层" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--
                            键盘大小：选完即存成默认，下次打开这个页面直接就是这一档。
                            它同时是这个页面的**最小尺寸** —— 换大档窗口会被撑到装得下，
                            换小档窗口可以缩得更小。
                        -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <TextBlock Text="键盘大小" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SizeBox" Style="{StaticResource ComboBox.Base}" Width="146"
                                      SelectionChanged="OnKeyboardSizeChanged"
                                      ToolTip="选一个当作默认大小；这就是这个页面能缩到的最小尺寸" />
                            <TextBlock x:Name="SizeText" Text="" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!--
                        ② 键盘本体。

                        纵向滚动**故意关掉**：一层 ScrollViewer 里同时能横能纵，
                        一旦横向滚动条冒出来（占 17 DIP 高），内容就又高出 17 DIP，
                        纵向滚动条跟着出现、再吃掉 17 DIP 宽 —— 于是横向的又不够了，
                        窗口边缘拖动时会看到两条滚动条互相触发着闪。
                        纵向交给外面整页那个 PageScroll，这里只管横向。
                    -->
                    <ScrollViewer Grid.Row="1" x:Name="KeyboardScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  PanningMode="HorizontalOnly">
                        <!--
                            Viewbox 只做一件事：把 1058×330 的设计图按档位放大/缩小。
                            它自己的 Width/Height 由 ApplyKeyboardSize 按档位写死，
                            所以"窗口多大"和"键帽多大"彻底解耦 ——
                            不会再出现"拖一下窗口，字就糊一档"。

                            水平居中靠 HorizontalAlignment：ScrollViewer 在内容
                            **装得下**时会把内容撑到可视区宽度，Center 因此生效；
                            装不下时内容按自身宽度排版，滚动条接管。两种情况都不用手算。
                        -->
                        <Viewbox x:Name="KeyboardPanel" Margin="0,2,0,2"
                                 Stretch="Uniform" StretchDirection="Both"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </ScrollViewer>

                    <!-- ③ 控制条 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="层" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LayerBox" Style="{StaticResource ComboBox.Base}" Width="240"
                                      SelectionChanged="OnLayerChanged" />
                            <!--
                                层内修饰键（子层）按钮。
                                这里**动态生成** —— 每层可以配 0~10 个修饰键组合，
                                所以不能再写死 5 个固定按钮。
                            -->
                            <TextBlock Text="层内修饰键" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <StackPanel x:Name="SubLayerPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="设置子层…" x:Name="EditSubLayersButton"
                                    Style="{StaticResource Button.Ghost}" Padding="10,5" Margin="6,0,0,0"
                                    Click="OnEditSubLayers"
                                    ToolTip="配置这一层要用哪些修饰键作为子层（最多 10 个）" />
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="CountText" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />

                            <!-- 颜色图例：不看文字也知道深蓝=已绑定 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="14,0,0,0">
                                <Border Width="12" Height="12" CornerRadius="3"
                                        Background="{DynamicResource Brush.Accent}"
                                        BorderBrush="{DynamicResource Brush.AccentHover}" BorderThickness="1"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="已绑定" Style="{StaticResource Text.Tertiary}"
                                           Margin="5,0,12,0" VerticalAlignment="Center" />
                                <Border Width="12" Height="12" CornerRadius="3"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="未绑定" Style="{StaticResource Text.Tertiary}"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 编辑面板：就在键盘正下方，横向占满整张卡片 -->
            <Border x:Name="EditorCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                <!--
                    布局：标题固定 → 中间那块自然长高 → 底部按钮接在最后。

                    ⚠ 这里**不再有自己的 ScrollViewer**：整页已经有一个纵向滚动
                    （外层 PageScroll），再套一层就会出现"滚到一半卡住、
                    得换到里面继续滚"的鼠标陷阱。编辑内容多高就多高，页面往下延伸。

                    ⚠ 中间那块是 Auto 高度，内容多高就多高 —— 一旦「自定义按键」面板展开，
                    总高度会超过卡片，所以整页是滚动的（外层 PageScroll）。
                    两个操作按钮（测试一下 / 清除绑定）已经提到标题行右侧，
                    不再需要底部那条分隔线和第三行。
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- 标题行：左边"在改哪个键"，右边是整条绑定的两个操作。
                             以前这两个按钮在卡片最底部、还隔着一道分隔线，
                             要多占一行高度 —— 提到标题右侧之后，滚到编辑区就看见了。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="编辑绑定" Style="{StaticResource Text.H2}"
                                       VerticalAlignment="Center" />

                            <!--
                                当前选中的是哪个键。
                                编辑区搬到键盘下方之后，两者离得远了 ——
                                不再有"右边面板永远显示当前键"的空间暗示，
                                这里必须明确写出来，否则用户滚下来会忘了在改谁。
                            -->
                            <Border Grid.Column="1" Style="{StaticResource Keycap}" Padding="9,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EditorKeyText" Text="Q" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TestBindButton" Content="测试一下"
                                        Style="{StaticResource Button.Ghost}" Padding="11,5"
                                        Click="OnTestClick"
                                        ToolTip="执行一次这个功能（可能影响当前窗口）" />
                                <Button x:Name="ClearBindButton" Content="清除绑定"
                                        Style="{StaticResource Button.Danger}" Padding="11,5" Margin="6,0,0,0"
                                        Click="OnClearClick" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <!-- 编辑主体：内容多高就多高，由整页滚动（不再自己套 ScrollViewer） -->
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <!-- ================= 普通分类：搜索 + 分类 + 功能 一行三组 =================
                             搜索框以前独占一整行，下面再一行分类 + 功能 —— 编辑区首屏被吃掉
                             两行高度。它本来就是"跨分类直接找功能"的快捷入口，和右边两个下拉
                             是同一件事的两种走法（先搜，搜不到再翻分类），并排才顺手。

                             宽度分配：搜索固定 240（够放下四五个字的搜索结果摘要）、分类固定
                             150（最长"自定义按键"五个字）、功能吃满剩余 —— 它的值最长
                             （"直达链接 · 直达文件"这种），也最需要看全。
                             三组都走"标签在上、控件在下"，所以基线天然对齐。
                        -->
                        <Grid x:Name="NormalActionPicker">
                            <!-- 两行是为了窄窗口降级：搜索放不下时下沉到第二行（见 OnPageScrollSizeChanged） -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                快速搜索：输入后弹出**独立的结果列表**，
                                点一条就把「分类」「功能」「参数」三项一起跳过去。
                                不是把结果塞进功能下拉 —— 那样看不出分类，也没法直接跳。
                            -->
                            <StackPanel x:Name="SearchGroup" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="搜索" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <Grid>
                                    <TextBox x:Name="ActionSearchBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="34" VerticalContentAlignment="Center"
                                             TextChanged="OnActionSearchChanged"
                                             ToolTip="搜索功能名、分类、宏名或网址，例如 删除 / 宏 / github" />

                                    <!-- 搜索结果浮层：贴在搜索框下方 -->
                                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=ActionSearchBox}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade" IsOpen="False">
                                        <Border Margin="0,4,0,0" CornerRadius="10" Padding="4"
                                                MaxHeight="320"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
                                            </Border.Effect>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="312">
                                                <ListBox x:Name="SearchResultList" Background="Transparent"
                                                         BorderThickness="0" Width="360"
                                                         ItemContainerStyle="{StaticResource RowItem}"
                                                         SelectionChanged="OnSearchResultSelected">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="2,3">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}"
                                                                           Style="{StaticResource Text.Tertiary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="功能" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <!--
                                    普通下拉（不设 IsEditable）。
                                    可编辑模式下 WPF 不会自动把选中项填进显示区，
                                    会出现"下拉空白"的问题；而且 300 多个引擎
                                    靠上面的搜索框过滤更好用。
                                -->
                                <ComboBox x:Name="ActionBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnActionChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                        </Grid>

                        <!-- ================= 窗口绑定：只有分类 + 两个按钮 =================
                             选了「窗口绑定」分类后，这里不再有"功能"下拉 ——
                             因为"绑哪个窗口"不是从列表里选，而是去抓。

                             两个入口对应两种真实场景：
                               · 点选窗口  → 程序已经开着，鼠标变准星点一下那个窗口即可
                               · 选择程序  → 知道装在哪 / 还没运行，从资源管理器挑 exe
                        -->
                        <StackPanel x:Name="WinBindPicker" Visibility="Collapsed">
                            <!-- 分类与"绑定方式"并排：两者都是"先选一个、再去操作"，
                                 竖着排会白白多占一行。按钮与下拉同高对齐（MinHeight 34）。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                    <ComboBox x:Name="CategoryBoxWinBind" Style="{StaticResource ComboBox.Base}"
                                              SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="绑定方式" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PickWindowButton" Style="{StaticResource Button.Primary}"
                                                Padding="14,6" MinHeight="34" Click="OnPickWindowClick"
                                                ToolTip="鼠标变成准星，点哪个窗口就绑哪个程序">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B3;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="点选窗口" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="PickExeButton" Style="{StaticResource Button.Base}"
                                                Padding="14,6" MinHeight="34" Margin="10,0,0,0"
                                                Click="OnPickExeClick"
                                                ToolTip="从资源管理器挑一个 exe（程序没在运行也能绑）">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="选择程序文件" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 一句话说清两者区别；详细提示在各自按钮的 ToolTip 里 -->
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,9,0,0"
                                       Text="点选窗口：鼠标变准星，点哪个窗口就绑哪个；选择程序文件：从资源管理器挑 exe（程序没在运行也能绑）。" />
                        </StackPanel>

                        <!-- ================= 直达链接：填目标 → 自动识别类型 =================
                             以前要用户先在三类里挑一个（网址 / 文件夹 / 文件），
                             挑错了就按错的方式打开（把 D:\Work 当网址拼成 http://d:\Work）。
                             现在只留一个输入框：边填边识别，结果用徽标明示，
                             底层动作跟着自动切换，用户不需要知道"类型"这回事。
                        -->
                        <StackPanel x:Name="WebPagePicker" Visibility="Collapsed">
                            <!-- 主行四组：分类 → 备注 → 目标 → 浏览。
                                 分组逻辑：左边是"元信息"（分类决定怎么打开、备注是给人看的名字，
                                 都可以留空或很短），右边是"操作区"（目标 + 紧跟它的浏览按钮）。
                                 以前这四样各占一行、每行还顶一个标签，四行才装得下。 -->
                            <Grid>
                                <!-- 第二行留给窄窗口：备注会被挪下去（见 OnPageScrollSizeChanged） -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                    <ComboBox x:Name="CategoryBoxWeb" Style="{StaticResource ComboBox.Base}"
                                              SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                                </StackPanel>

                                <StackPanel x:Name="NoteGroupWeb" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <TextBox x:Name="WebNoteBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="36" VerticalContentAlignment="Center"
                                             TextChanged="OnWebNoteChanged"
                                             ToolTip="给这个链接起个好记的名字，会显示在键帽上" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock x:Name="LinkTargetLabel" Text="目标（网址 / 文件夹 / 文件，自动识别）"
                                               Style="{StaticResource Text.Secondary}" Margin="0,0,0,7"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="WebUrlBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="36" VerticalContentAlignment="Center"
                                             TextChanged="OnWebUrlChanged"
                                             ToolTip="网址（https://github.com 或不带 http 的 github.com）、文件夹、文件都能填，类型自动识别" />
                                </StackPanel>

                                <!-- 两个浏览按钮没有标签，因此**底对齐**到输入框底边 ——
                                     与「标签在上」的组不同，它们只占控件那一行。 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <Button x:Name="BrowseFolderButton" Content="浏览…"
                                            Style="{StaticResource Button.Base}" Padding="12,6" MinHeight="36"
                                            Visibility="Collapsed" Click="OnBrowseFolder"
                                            ToolTip="从资源管理器里挑一个文件夹" />
                                    <Button x:Name="BrowseFileButton" Content="浏览…"
                                            Style="{StaticResource Button.Base}" Padding="12,6" MinHeight="36"
                                            Margin="8,0,0,0" Visibility="Collapsed" Click="OnBrowseFile"
                                            ToolTip="从资源管理器里挑一个文件" />
                                </StackPanel>
                            </Grid>

                            <!-- 识别结果：一眼看出"系统认为这是什么"。
                                 颜色分开（网址蓝 / 文件夹绿 / 文件橙 / 认不出灰），
                                 右边那行小字说明按下去到底会发生什么；最右是网址专有的操作。 -->
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" x:Name="LinkKindBadge" Style="{StaticResource Badge}"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        BorderBrush="{DynamicResource Brush.AccentSoftBorder}">
                                    <TextBlock x:Name="LinkKindText" Style="{StaticResource Badge.Text}"
                                               Text="自动识别" />
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="LinkKindHint"
                                           Style="{StaticResource Text.Tertiary}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="2" x:Name="FetchTitleButton" Content="重新取标题"
                                        Style="{StaticResource Button.Ghost}" Padding="10,4"
                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                        Click="OnFetchTitleClick"
                                        ToolTip="再抓一次那个网页的标题" />
                            </Grid>

                            <TextBlock x:Name="WebFetchStatus" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock x:Name="LinkHint" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="网址、文件夹、文件都填在这里，类型自动识别，不用自己选。填网址会自动抓网页标题当备注；路径不填备注时用文件夹名或文件名。备注会显示在键帽上。" />
                        </StackPanel>

                        <!-- ================= 输入文本 =================
                             选了「输入文本」分类后，只要一个多行文本框：
                             填进去的文字会在按键触发时直接打到当前光标处。
                        -->
                        <StackPanel x:Name="TypeTextPicker" Visibility="Collapsed">
                            <!-- 元信息一行（分类 + 备注），正文独占下面 ——
                                 多行文本框有自己的高度，和下拉/单行输入塞不到一行去。 -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                    <ComboBox x:Name="CategoryBoxType" Style="{StaticResource ComboBox.Base}"
                                              SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                                </StackPanel>

                                <StackPanel x:Name="NoteGroupType" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <TextBox x:Name="TypeNoteBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="36" VerticalContentAlignment="Center"
                                             TextChanged="OnTypeNoteChanged"
                                             ToolTip="给这段文字起个好记的名字，会显示在键帽上" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="0,16,0,0"
                                           Text="备注会显示在键帽上；不填就显示文字开头几个字。" />
                            </Grid>

                            <!-- 正文：标签左置（不再单独占一行），文本框吃满剩余宽度 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TypeTextBoxLabel" Text="要输入的文字"
                                           Style="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Top" Margin="0,10,10,0" />
                                <TextBox Grid.Column="1" x:Name="TypeTextBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="84" MaxHeight="180" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         TextChanged="OnTypeTextChanged"
                                         ToolTip="触发这个键时，会把这里的内容直接输入到当前光标处" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="支持中文与 emoji；不会动你的剪贴板。可以多行（会带换行一起输入）。" />
                        </StackPanel>

                        <!-- ================= 自定义按键 =================
                             选了「自定义按键」分类后，下面换成这个面板。

                             这个分类解决的是"把某个键转发给某个常驻程序"：
                             先确认程序在跑（没跑就先拉起来），再把设定的键发过去。

                             ⚠ 这里的"按键"只是**要发送的键**，不是导航用的 ——
                             捕获它不会改变左边键盘的选中状态。
                             以前那个独立的「自定义按键…」按钮会顺手改掉
                             当前层/当前键，导致整个视图跳到一个空的修饰子层，
                             看起来像"所有绑定都没了"。现在改成参数，不再动视图。
                        -->
                        <StackPanel x:Name="CustomKeyPicker" Visibility="Collapsed">
                            <!-- 三行装完原来六行的内容：
                                   ① 元信息（分类 + 备注）+ 要发送的键
                                   ② 绑定应用 + 浏览
                                   ③ 三个开关并排
                                 开关原来每个都顶着两三行说明、竖着排，一条"自定义按键"
                                 光开关就占掉半屏；现在说明压成一句短的，长的进 ToolTip。 -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                    <ComboBox x:Name="CategoryBoxCustom" Style="{StaticResource ComboBox.Base}"
                                              SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="要发送的键" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CustomKeyCaptureButton" Content="按下要发送的键…"
                                                Style="{StaticResource Button.Base}" Padding="14,6" MinHeight="36"
                                                Click="OnCustomKeyCapture"
                                                ToolTip="点一下，然后在键盘上按你想发给应用的键（支持 Ctrl / Shift / Alt 组合）" />
                                        <Border x:Name="CustomKeyBadge" Style="{StaticResource Keycap}"
                                                Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="CustomKeyBadgeText" Text="" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="NoteGroupCustom" Grid.Column="2">
                                    <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <TextBox x:Name="CustomNoteBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="36" VerticalContentAlignment="Center"
                                             TextChanged="OnCustomNoteChanged"
                                             ToolTip="给这个键起个好记的名字，会显示在键帽上" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="绑定应用" Style="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,7" />
                                    <TextBox x:Name="CustomAppBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="36" VerticalContentAlignment="Center"
                                             TextChanged="OnCustomAppChanged"
                                             ToolTip="要接收这个键的程序，例如 C://Program Files\Tencent\Weixin\Weixin.exe" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Button.Base}"
                                        Padding="12,6" MinHeight="36" VerticalAlignment="Bottom"
                                        Click="OnBrowseCustomApp"
                                        ToolTip="从资源管理器里挑一个 exe" />
                            </Grid>
                            <TextBlock x:Name="CustomAppStatus" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <!-- 三个开关并排：每个都是"一句短说明 + 开关"，完整解释进 ToolTip -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="以管理员身份启动" Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center" />
                                        <CheckBox x:Name="CustomAdminBox" Style="{StaticResource ToggleSwitch}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Click="OnCustomAdminChanged"
                                                  ToolTip="仅在需要拉起这个程序时生效，会弹一次 UAC 确认。程序本来就在跑时不受影响。" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Text="仅拉起程序时生效，会弹一次 UAC。" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="把主窗口切到前台" Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center" />
                                        <CheckBox x:Name="CustomMainWindowBox" Style="{StaticResource ToggleSwitch}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Click="OnCustomMainWindowChanged"
                                                  ToolTip="关（默认）：不动它的窗口，按键直接交给系统 —— 应用把这个键注册成全局热键时，在后台也能收到。&#x0a;开：先把它的主窗口切到前台再发键，适合「这个键只在它被激活时才有意义」。会抢走你当前的焦点。" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Text="开会抢焦点；关着时后台也能收到热键。" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="发键前等待" Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="CustomWaitBox" Style="{StaticResource TextBox.Base}"
                                                 Width="76" MinHeight="34" Margin="10,0,0,0"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 TextChanged="OnCustomWaitChanged"
                                                 ToolTip="窗口出现不代表能收键盘（程序还在加载界面）。大型软件常常 900 毫秒不够，可以调大；小工具可以调小甚至填 0。" />
                                        <TextBlock Text="毫秒" Style="{StaticResource Text.Tertiary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Text="窗口出现 ≠ 能收键盘，大软件可调大。" />
                                </StackPanel>
                            </Grid>

                        <TextBlock x:Name="CustomKeyHint" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- ============ 说明 + 参数：一行两段 ============
                             以前这两个各占一整行：参数输入框本来就是一根很长的横条，
                             右边却空着；说明文字也常常只写半行，右半截全是空白。
                             现在宽的时候并排（说明在左吃满剩余、参数靠右固定 340），
                             窄的时候参数换到第二行 —— 判断在 OnPageScrollSizeChanged。

                             为什么参数在右：左边是"读"（这个功能是干什么的），
                             右边是"填"（要给它一个参数）。视线从说明扫到参数，
                             正好是"看完说明顺手填"的顺序。 -->
                        <Grid x:Name="DescArgRow" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="ActionDesc" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <!-- 普通参数面板：并排时固定 340、单行高；换行后自动铺满整行 -->
                            <StackPanel Grid.Column="1" x:Name="ArgPanel" Width="340"
                                        Visibility="Collapsed" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="ArgLabel" Text="参数"
                                               Style="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBox Grid.Column="1" x:Name="ArgBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="34" VerticalContentAlignment="Center"
                                             TextChanged="OnArgChanged" />

                                    <!-- 音量 / 亮度这类"步进"参数：一键回到设置里的幅度。
                                         留空 = 跟随设置页的滑杆，用户不必记自己填过什么。 -->
                                    <Button x:Name="ArgDefaultButton" Grid.Column="2" Content="用默认"
                                            Style="{StaticResource Button.Ghost}" Padding="10,5"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="Collapsed" Click="OnArgUseDefault"
                                            ToolTip="清空这里，改用设置页里的调节幅度" />
                                </Grid>
                                <TextBlock x:Name="ArgHint" Style="{StaticResource Text.Tertiary}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!--
                            就地状态提示。
                            之前绑定成功后只弹右下角 toast，用户正盯着主窗口根本注意不到，
                            感觉像"没提示"。这里直接在编辑区里显示一行结果。
                        -->
                        <!-- 只是一句"已绑定 / 绑定失败"的提示，不该横成一条通栏横幅：
                             内容多长就多长（Left 对齐），短提示自然缩成一个小胶囊。 -->
                        <Border x:Name="BindStatusBar" Margin="0,10,0,0" Padding="11,7" CornerRadius="8"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="BindStatusText" FontSize="12" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- ============ 已绑定的程序（窗口绑定专用） ============ -->
                        <Border x:Name="WinBindPanel" Margin="0,14,0,0" Padding="14,12" CornerRadius="11"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="当前绑定" Style="{StaticResource Text.Secondary}"
                                           Margin="0,0,0,8" />

                                <!-- 已选中的程序：图标 + 名字 + 路径 -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image x:Name="WinBindIcon" Stretch="Uniform" Margin="4" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WinBindName" Text="还没选择" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="WinBindPath" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="WinBindClearButton" Content="清除"
                                            Style="{StaticResource Button.Ghost}" Padding="10,5"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            Click="OnWinBindClear" />
                                </Grid>

                                <!-- 自定义显示名：exe 名不一定是软件名（如 idea64.exe 其实是 IDEA） -->
                                <TextBlock Text="显示名称（可选）" Style="{StaticResource Text.Secondary}"
                                           Margin="0,12,0,7" />
                                <TextBox x:Name="WinBindNoteBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="34" VerticalContentAlignment="Center"
                                         TextChanged="OnWinBindNoteChanged"
                                         ToolTip="留空则用程序文件名。可以改成你认得的名字，会显示在键帽上" />

                                <TextBlock x:Name="WinBindHint" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>


                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
