<UserControl x:Class="CapsLockPlus.UI.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 布局方案固定为新版（Capslox），不再提供切换 —— 旧方案
                     只是历史兼容，留着下拉只会让人误以为要选一个。
                     旁边那个搜索框也移除了：它原本用于过滤按键，
                     但实际使用中几乎没人用，反而占掉一行空间。 -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                           Text="点击键盘上任意键即可编辑它的功能，修改立即生效" />

                <Button Grid.Column="1" Content="恢复默认" Style="{StaticResource Button.Base}"
                        Margin="16,0,0,0" Click="OnResetClick" />
            </Grid>
        </Border>

        <!-- 主体：左键盘 + 右编辑 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 键盘 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <!--
                                这里是**当前层的触发键**，不是写死的 CapsLock。
                                不同层可以配不同的触发键（F13、右 Alt、甚至可以组合），
                                写死大写键会让切到第 2 层后提示与实际完全对不上。
                            -->
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock x:Name="TriggerKeyBadge" Text="按住 CapsLock"
                                           Style="{StaticResource Badge.Text}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <TextBlock x:Name="TriggerKeySuffix" Text="+ 下面的键"
                                       Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="7,0,0,0" />
                            <TextBlock x:Name="LayerHint" Text="当前：基础层" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.AccentSoft}"
                                     Stroke="{DynamicResource Brush.AccentSoftBorder}" StrokeThickness="1"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="已绑定" Style="{StaticResource Text.Tertiary}" Margin="6,0,14,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Keycap}"
                                     Stroke="{DynamicResource Brush.KeycapBorder}" StrokeThickness="1"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="未绑定" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" x:Name="KeyboardPanel" VerticalAlignment="Top" Margin="0,4,0,0" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="层" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LayerBox" Style="{StaticResource ComboBox.Base}" Width="260"
                                      SelectionChanged="OnLayerChanged" />
                        </StackPanel>
                        <!--
                            层内修饰键（子层）按钮。
                            这里**动态生成** —— 每层可以配 0~10 个修饰键组合，
                            所以不能再写死 5 个固定按钮。
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="层内修饰键" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel x:Name="SubLayerPanel" Orientation="Horizontal" />
                            <Button Content="设置子层…" x:Name="EditSubLayersButton"
                                    Style="{StaticResource Button.Ghost}" Padding="10,5" Margin="6,0,0,0"
                                    Click="OnEditSubLayers"
                                    ToolTip="配置这一层要用哪些修饰键作为子层（最多 10 个）" />
                        </StackPanel>
                        <TextBlock x:Name="CountText" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />

                        <!-- 颜色图例：不看文字也知道深蓝=已绑定 -->
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Border Width="13" Height="13" CornerRadius="3"
                                    Background="{DynamicResource Brush.Accent}"
                                    BorderBrush="{DynamicResource Brush.AccentHover}" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="已绑定功能" Style="{StaticResource Text.Tertiary}"
                                       Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Border Width="13" Height="13" CornerRadius="3"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="未绑定" Style="{StaticResource Text.Tertiary}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 编辑面板 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                <!--
                    布局：标题固定 → 中间整块可滚动 → 底部按钮固定。

                    ⚠ 以前中间那几行是 Auto 高度：一旦「自定义按键」面板展开
                    （键 / 应用 / 两个开关 / 等待 / 备注 / 提示），总高度就超过卡片，
                    把底部的「清除绑定」「测试一下」挤出可视区，怎么滚都看不到
                    —— 因为溢出的是 Grid 行，不是 ScrollViewer 里的内容。
                    现在只有 3 行：中间一行是 *，内部整块滚动；按钮永远贴底。
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="编辑绑定" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!--
                            快速搜索：输入后弹出**独立的结果列表**，
                            点一条就把「分类」「功能」「参数」三项一起跳过去。
                            不是把结果塞进功能下拉 —— 那样看不出分类，也没法直接跳。
                        -->
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="ActionSearchBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="34" VerticalContentAlignment="Center"
                                     TextChanged="OnActionSearchChanged"
                                     ToolTip="搜索功能名、分类、宏名或网址，例如 删除 / 宏 / github" />

                            <!-- 搜索结果浮层：贴在搜索框下方 -->
                            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=ActionSearchBox}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" IsOpen="False">
                                <Border Margin="0,4,0,0" CornerRadius="10" Padding="4"
                                        MaxHeight="320"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="312">
                                        <ListBox x:Name="SearchResultList" Background="Transparent"
                                                 BorderThickness="0" Width="360"
                                                 ItemContainerStyle="{StaticResource RowItem}"
                                                 SelectionChanged="OnSearchResultSelected">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,3">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Style="{StaticResource Text.Tertiary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="EditorScroll" Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                    <StackPanel>
                        <!-- ================= 普通分类：分类 + 功能 两级下拉 ================= -->
                        <Grid x:Name="NormalActionPicker">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="功能" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                                <!--
                                    普通下拉（不设 IsEditable）。
                                    可编辑模式下 WPF 不会自动把选中项填进显示区，
                                    会出现"下拉空白"的问题；而且 300 多个引擎
                                    靠上面的搜索框过滤更好用。
                                -->
                                <ComboBox x:Name="ActionBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnActionChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                        </Grid>

                        <!-- ================= 窗口绑定：只有分类 + 两个按钮 =================
                             选了「窗口绑定」分类后，这里不再有"功能"下拉 ——
                             因为"绑哪个窗口"不是从列表里选，而是去抓。

                             两个入口对应两种真实场景：
                               · 点选窗口  → 程序已经开着，鼠标变准星点一下那个窗口即可
                               · 选择程序  → 知道装在哪 / 还没运行，从资源管理器挑 exe
                        -->
                        <StackPanel x:Name="WinBindPicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxWinBind" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock Text="绑定方式" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PickWindowButton" Style="{StaticResource Button.Primary}"
                                        Padding="16,9" Click="OnPickWindowClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="点选窗口" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PickExeButton" Style="{StaticResource Button.Base}"
                                        Padding="16,9" Margin="10,0,0,0" Click="OnPickExeClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="选择程序文件" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="点选窗口：鼠标变成准星，点哪个窗口就绑哪个程序。&#x0a;选择程序文件：从资源管理器挑一个 exe（程序没在运行也能绑）。" />
                        </StackPanel>

                        <!-- ================= 直达链接：网址 / 文件夹 / 文件 + 备注 =================
                             选了「直达链接」分类后，下面换成这个面板：
                             先选类型（网址 / 文件夹 / 文件），再填目标，备注可选。
                        -->
                        <StackPanel x:Name="WebPagePicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxWeb" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock Text="链接类型" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <!-- 只放文字、不放图标字体：E774 这类 globe 字形在
                                     部分 Win10 的 Fluent Icons 里是空白/方框，
                                     与其赌字体，不如让三个按钮靠样式区分选中态。 -->
                                <Button x:Name="LinkKindUrlButton" Content="直达网址"
                                        Style="{StaticResource Button.Base}"
                                        Padding="18,8" MinWidth="96" Click="OnLinkKindUrl"
                                        ToolTip="按这个键用默认浏览器打开网址" />
                                <Button x:Name="LinkKindFolderButton" Content="直达文件夹"
                                        Style="{StaticResource Button.Base}"
                                        Padding="18,8" MinWidth="108" Margin="8,0,0,0"
                                        Click="OnLinkKindFolder"
                                        ToolTip="按这个键在文件资源管理器里打开文件夹" />
                                <Button x:Name="LinkKindFileButton" Content="直达文件"
                                        Style="{StaticResource Button.Base}"
                                        Padding="18,8" MinWidth="96" Margin="8,0,0,0"
                                        Click="OnLinkKindFile"
                                        ToolTip="按这个键用系统默认程序打开文件" />
                            </StackPanel>

                            <TextBlock x:Name="LinkTargetLabel" Text="网址"
                                       Style="{StaticResource Text.Secondary}" Margin="0,14,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WebUrlBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="36" VerticalContentAlignment="Center"
                                         TextChanged="OnWebUrlChanged"
                                         ToolTip="例如 https://github.com；不带 http 也会自动补全" />
                                <Button Grid.Column="1" x:Name="BrowseFolderButton" Content="浏览…"
                                        Style="{StaticResource Button.Base}" Padding="12,6" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="OnBrowseFolder"
                                        ToolTip="从资源管理器里挑一个文件夹" />
                                <Button Grid.Column="2" x:Name="BrowseFileButton" Content="浏览…"
                                        Style="{StaticResource Button.Base}" Padding="12,6" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="OnBrowseFile"
                                        ToolTip="从资源管理器里挑一个文件" />
                            </Grid>

                            <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                       Margin="0,12,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WebNoteBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="36" VerticalContentAlignment="Center"
                                         TextChanged="OnWebNoteChanged"
                                         ToolTip="给这个链接起个好记的名字，会显示在键帽上" />
                                <Button Grid.Column="1" x:Name="FetchTitleButton" Content="重新取标题"
                                        Style="{StaticResource Button.Base}" Padding="12,6" Margin="8,0,0,0"
                                        Click="OnFetchTitleClick"
                                        ToolTip="再抓一次那个网页的标题" />
                            </Grid>
                            <TextBlock x:Name="WebFetchStatus" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="LinkHint" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="填网址时会自动抓网页标题当备注（不满意可以改）；填文件夹时默认用文件夹名。备注会显示在键帽上。" />
                        </StackPanel>

                        <!-- ================= 输入文本 =================
                             选了「输入文本」分类后，只要一个多行文本框：
                             填进去的文字会在按键触发时直接打到当前光标处。
                        -->
                        <StackPanel x:Name="TypeTextPicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxType" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock x:Name="TypeTextBoxLabel" Text="要输入的文字" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <TextBox x:Name="TypeTextBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="90" MaxHeight="180" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnTypeTextChanged"
                                     ToolTip="触发这个键时，会把这里的内容直接输入到当前光标处" />

                            <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                       Margin="0,12,0,7" />
                            <TextBox x:Name="TypeNoteBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="36" VerticalContentAlignment="Center"
                                     TextChanged="OnTypeNoteChanged"
                                     ToolTip="给这段文字起个好记的名字，会显示在键帽和已绑定列表里" />

                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="支持中文与 emoji；不会动你的剪贴板。可以多行（会带换行一起输入）。填了备注就显示备注，否则显示文字开头几个字。" />
                        </StackPanel>

                        <!-- ================= 自定义按键 =================
                             选了「自定义按键」分类后，下面换成这个面板。

                             这个分类解决的是"把某个键转发给某个常驻程序"：
                             先确认程序在跑（没跑就先拉起来），再把设定的键发过去。

                             ⚠ 这里的"按键"只是**要发送的键**，不是导航用的 ——
                             捕获它不会改变左边键盘的选中状态。
                             以前那个独立的「自定义按键…」按钮会顺手改掉
                             当前层/当前键，导致整个视图跳到一个空的修饰子层，
                             看起来像"所有绑定都没了"。现在改成参数，不再动视图。
                        -->
                        <StackPanel x:Name="CustomKeyPicker" Visibility="Collapsed">
                            <TextBlock Text="分类" Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />
                            <ComboBox x:Name="CategoryBoxCustom" Style="{StaticResource ComboBox.Base}"
                                      Width="150" HorizontalAlignment="Left"
                                      SelectionChanged="OnCategoryChanged" MaxDropDownHeight="420" />

                            <TextBlock Text="要发送的键" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CustomKeyCaptureButton" Content="按下要发送的键…"
                                        Style="{StaticResource Button.Base}" Padding="14,8"
                                        Click="OnCustomKeyCapture"
                                        ToolTip="点一下，然后在键盘上按你想发给应用的键（支持 Ctrl / Shift / Alt 组合）" />
                                <Border x:Name="CustomKeyBadge" Style="{StaticResource Keycap}"
                                        Padding="12,6" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="CustomKeyBadgeText" Text="" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="绑定应用" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="CustomAppBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="36" VerticalContentAlignment="Center"
                                         TextChanged="OnCustomAppChanged"
                                         ToolTip="要接收这个键的程序，例如 C:\Program Files\Tencent\Weixin\Weixin.exe" />
                                <Button Grid.Column="1" Content="浏览…"
                                        Style="{StaticResource Button.Base}" Padding="12,6" Margin="8,0,0,0"
                                        Click="OnBrowseCustomApp"
                                        ToolTip="从资源管理器里挑一个 exe" />
                            </Grid>
                            <TextBlock x:Name="CustomAppStatus" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="以管理员身份启动" Style="{StaticResource Text.Body}" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Text="仅在需要拉起这个程序时生效，会弹一次 UAC 确认。程序本来就在跑时不受影响。" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="CustomAdminBox"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Click="OnCustomAdminChanged" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="把应用主窗口切到前台" Style="{StaticResource Text.Body}" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Text="关（默认）：不动它的窗口，按键直接交给系统 —— 应用把这个键注册成全局热键时，在后台也能收到。&#x0a;开：先把它的主窗口切到前台再发键，适合「这个键只在它被激活时才有意义」。会抢走你当前的焦点。" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="CustomMainWindowBox"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Click="OnCustomMainWindowChanged" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="启动后等多久再发键" Style="{StaticResource Text.Body}" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Text="窗口出现不代表能收键盘（程序还在加载界面）。大型软件常常 900 毫秒不够，可以调大；小工具可以调小甚至填 0。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="CustomWaitBox" Style="{StaticResource TextBox.Base}"
                                             Width="76" MinHeight="34" VerticalContentAlignment="Center"
                                             TextAlignment="Center" TextChanged="OnCustomWaitChanged" />
                                    <TextBlock Text="毫秒" Style="{StaticResource Text.Tertiary}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="备注（可选）" Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,7" />
                            <TextBox x:Name="CustomNoteBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="36" VerticalContentAlignment="Center"
                                     TextChanged="OnCustomNoteChanged"
                                     ToolTip="给这个键起个好记的名字，会显示在键帽和已绑定列表里" />

                            <TextBlock x:Name="CustomKeyHint" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="ActionDesc" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <!--
                            就地状态提示。
                            之前绑定成功后只弹右下角 toast，用户正盯着主窗口根本注意不到，
                            感觉像"没提示"。这里直接在编辑区里显示一行结果。
                        -->
                        <Border x:Name="BindStatusBar" Margin="0,10,0,0" Padding="11,8" CornerRadius="8"
                                Visibility="Collapsed">
                            <TextBlock x:Name="BindStatusText" FontSize="12" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- ============ 已绑定的程序（窗口绑定专用） ============ -->
                        <Border x:Name="WinBindPanel" Margin="0,14,0,0" Padding="14,12" CornerRadius="11"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="当前绑定" Style="{StaticResource Text.Secondary}"
                                           Margin="0,0,0,8" />

                                <!-- 已选中的程序：图标 + 名字 + 路径 -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image x:Name="WinBindIcon" Stretch="Uniform" Margin="4" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WinBindName" Text="还没选择" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="WinBindPath" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="WinBindClearButton" Content="清除"
                                            Style="{StaticResource Button.Ghost}" Padding="10,5"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            Click="OnWinBindClear" />
                                </Grid>

                                <!-- 自定义显示名：exe 名不一定是软件名（如 idea64.exe 其实是 IDEA） -->
                                <TextBlock Text="显示名称（可选）" Style="{StaticResource Text.Secondary}"
                                           Margin="0,12,0,7" />
                                <TextBox x:Name="WinBindNoteBox" Style="{StaticResource TextBox.Base}"
                                         MinHeight="34" VerticalContentAlignment="Center"
                                         TextChanged="OnWinBindNoteChanged"
                                         ToolTip="留空则用程序文件名。可以改成你认得的名字，会显示在键帽上" />

                                <TextBlock x:Name="WinBindHint" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- ============ 普通参数面板 ============ -->
                        <StackPanel x:Name="ArgPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ArgLabel" Text="参数" Style="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ArgBox" Grid.Column="0" Style="{StaticResource TextBox.Base}"
                                         MinHeight="36" VerticalContentAlignment="Center"
                                         TextChanged="OnArgChanged" />

                                <!-- 音量 / 亮度这类"步进"参数：一键回到设置里的幅度。
                                     留空 = 跟随设置页的滑杆，用户不必记自己填过什么。 -->
                                <Button x:Name="ArgDefaultButton" Grid.Column="1" Content="用默认"
                                        Style="{StaticResource Button.Ghost}" Padding="10,5"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="Collapsed" Click="OnArgUseDefault"
                                        ToolTip="清空这里，改用设置页里的调节幅度" />
                            </Grid>
                            <TextBlock x:Name="ArgHint" Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="本层已绑定" Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,8" />
                        </StackPanel>

                    <ListBox x:Name="BoundList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MinHeight="80" MaxHeight="240"
                             SelectionChanged="OnBoundSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Keycap}" Padding="7,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12.5" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作条：固定在卡片最下方，任何窗口尺寸下都不会被挤走 -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Brush.Border}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ClearBindButton" Content="清除绑定"
                                    Style="{StaticResource Button.Danger}" Padding="12,6"
                                    Click="OnClearClick" />
                            <Button x:Name="TestBindButton" Content="测试一下"
                                    Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                    Padding="12,6" Click="OnTestClick"
                                    ToolTip="执行一次这个功能（可能影响当前窗口）" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
