<UserControl x:Class="CapsLockPlus.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
             FontFamily="{StaticResource Font.Ui}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" Padding="24,4,20,20">
        <!-- 不再单独限宽 880：其它页面（快速上手 / 同步与备份 / 按键映射）都是铺满的，
             只有设置页缩在左边，1240 宽时右边空出 130 多、最大化时能空出 700 多，
             切页面时整块内容会"跳一下宽度"。 -->
        <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '启动与运行'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '这些选项会立刻保存，不需要重启程序。'}" Style="{StaticResource Text.Tertiary}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '开机自动启动'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '登录 Windows 后自动在托盘运行'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="StartupBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnStartupChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '关闭窗口时最小化到托盘'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '保留热键继续工作；从托盘菜单可以完全退出'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TrayBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnTrayChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '启动时打开设置窗口'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '关闭后只在托盘运行，按 Caps+Q 依然可用'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="OpenOnStartBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnOpenOnStartChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '操作后显示轻提示'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '例如切换置顶、复制到剪贴板时，在屏幕角落提示一下'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ToastBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToastChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 基础改键：不按住前缀键也生效 -->
                    <StackPanel x:Name="RemapSection" Background="Transparent">
                        <TextBlock Text="{loc:T '基础改键'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '不用按住任何前缀键，直接把某个键换成另一个键。层内绑定优先于这里。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <ComboBox x:Name="RemapDeviceBox" Margin="0,8,0,0" MinHeight="32"
                                  Style="{StaticResource ComboBox.Base}"
                                  ToolTip="{loc:T '选一只键盘：下面的预设只对它生效。选「所有键盘」则全局生效。'}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="Caps ↔ Esc" Tag="capsEsc" Click="OnRemapPresetClick" />
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="Ctrl ↔ Alt" Tag="ctrlAlt" Click="OnRemapPresetClick" />
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="Caps → Ctrl" Tag="capsCtrl" Click="OnRemapPresetClick" />
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="Win ↔ Alt" Tag="winAlt" Click="OnRemapPresetClick" />
                            <Button x:Name="RemapClearButton" Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="{loc:T '清除全部'}" Visibility="Collapsed" Click="OnRemapClearClick" />
                        </WrapPanel>
                        <TextBlock x:Name="RemapStateText" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 使用统计：把"省时间"量化出来 -->
                    <StackPanel>
                        <TextBlock Text="{loc:T '使用统计'}" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Name="UsageText" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <Button x:Name="UsageResetButton" Style="{StaticResource Button.Base}" Padding="12,5"
                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                Content="{loc:T '清空统计'}" Click="OnUsageResetClick" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 按应用自动启用层：只叠加，不接管 -->
                    <StackPanel x:Name="AppLayerSection" Background="Transparent">
                        <TextBlock Text="{loc:T '按应用自动启用层'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '切到这些程序时自动叠加它绑定的层：只接管该层绑过的组合，其余按键照常输入。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppLayerProcessBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     ToolTip="{loc:T '进程名，如 Code.exe（大小写不敏感）'}" />
                            <ComboBox x:Name="AppLayerLayerBox" Grid.Column="1" Width="168" Margin="8,0,0,0"
                                      Style="{StaticResource ComboBox.Base}" />
                            <Button x:Name="AppLayerAddButton" Grid.Column="2" Content="{loc:T '添加'}"
                                    Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddAppLayerClick" />
                        </Grid>
                        <ItemsControl x:Name="AppLayerList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 双击动作：任意键连按两次 -->
                    <StackPanel x:Name="GestureSection" Background="Transparent">
                        <TextBlock Text="{loc:T '双击动作'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '任意键连按两次触发一个动作。单击保持原样，第二次按下不会打出字符。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="GestureKeyBox" Width="130" Style="{StaticResource ComboBox.Base}" />
                            <ComboBox x:Name="GestureActionBox" Grid.Column="1" Margin="8,0,0,0"
                                      Style="{StaticResource ComboBox.Base}" />
                            <Button Grid.Column="2" Content="{loc:T '添加'}" Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddGestureClick" />
                        </Grid>
                        <ItemsControl x:Name="GestureList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 文本片段 -->
                    <StackPanel x:Name="SnippetSection" Background="Transparent">
                        <TextBlock Text="{loc:T '文本片段'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '输入触发词后自动展开成一段文字。触发词须以 ; / . 等符号开头（不能是字母数字），且必须落在词首。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SnippetTriggerBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     ToolTip="{loc:T '例如 ;mail'}" />
                            <TextBox x:Name="SnippetTextBox" Grid.Column="1" Margin="8,0,0,0" MinHeight="34"
                                     Style="{StaticResource TextBox.Base}" AcceptsReturn="True"
                                     ToolTip="{loc:T '展开后的内容，可换行'}" />
                            <Button Grid.Column="2" Content="{loc:T '添加'}" Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddSnippetClick" />
                        </Grid>
                        <TextBox x:Name="SnippetAppsBox" Margin="0,8,0,0" MinHeight="32"
                                 Style="{StaticResource TextBox.Base}"
                                 ToolTip="{loc:T '留空 = 所有程序都展开'}"
                                 TextChanged="OnSnippetAppsHint" />
                        <TextBlock x:Name="SnippetAppsHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{loc:T '可选：只在哪些程序里展开（进程名，逗号分隔，如 code.exe, notepad.exe）。留空 = 所有程序。'}" />
                        <ItemsControl x:Name="SnippetList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 组合键：两键同时按 -->
                    <StackPanel x:Name="ChordSection" Background="Transparent">
                        <TextBlock Text="{loc:T '组合键（两键同按）'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '两个键同时按下触发动作。被配置的这两个键会有约 70ms 的按下延迟（否则无法区分连打和同按），未配置的键不受影响。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChordKey1Box" Style="{StaticResource ComboBox.Base}" />
                            <ComboBox x:Name="ChordKey2Box" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ComboBox.Base}" />
                            <ComboBox x:Name="ChordActionBox" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource ComboBox.Base}" />
                            <Button Grid.Column="3" Content="{loc:T '添加'}" Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddChordClick" />
                        </Grid>
                        <ItemsControl x:Name="ChordList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 场景模板：一键合并常用搭配 -->
                    <StackPanel>
                        <TextBlock Text="{loc:T '场景模板'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '一键把一组常用搭配合并进当前配置。只添加缺失项，不会覆盖已有设置，重复点也没关系。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="{loc:T 'Vim 导航'}" Tag="vim" Click="OnApplyPackClick" />
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="{loc:T '窗口管理'}" Tag="window" Click="OnApplyPackClick" />
                            <Button Style="{StaticResource Button.Base}" Padding="12,5" Margin="0,0,8,8"
                                    Content="{loc:T '剪贴板效率'}" Tag="clip" Click="OnApplyPackClick" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 规则分享 -->
                    <StackPanel>
                        <TextBlock Text="{loc:T '规则分享'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '导出基础改键、文本片段、双击动作、组合键、按应用层（不含层内绑定）。把别人的分享码粘进来即可导入，只添加缺失项。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBox x:Name="ShareBox" Margin="0,8,0,0" MinHeight="72" AcceptsReturn="True"
                                 TextWrapping="Wrap" Style="{StaticResource TextBox.Base}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{loc:T '导出到框里'}" Padding="14,6" Margin="0,0,8,0"
                                    Style="{StaticResource Button.Base}" Click="OnExportRulesClick" />
                            <Button Content="{loc:T '从框里导入'}" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnImportRulesClick" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 规则体检：把"看起来生效、其实被覆盖"的配置摆出来 -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T '规则体检'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{loc:T '只检查、不改配置：列出被更高优先级的规则盖住、或者指向不存在的层这类问题。'}"
                                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="ConflictRecheckButton" Content="{loc:T '重新检查'}"
                                        Padding="12,5" Style="{StaticResource Button.Base}"
                                        Click="OnRecheckConflictsClick" />
                                <Button Content="{loc:T '复制结果'}" Padding="12,5" Margin="8,0,0,0"
                                        Style="{StaticResource Button.Base}" Click="OnCopyConflictsClick"
                                        ToolTip="{loc:T '复制成纯文本，便于求助时直接粘贴'}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ConflictEmptyText" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,8,0,0" Visibility="Collapsed"
                                   Text="{loc:T '没有发现问题。'}" />
                        <ItemsControl x:Name="ConflictList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 键盘设备：只读，用于排查"为什么另一只键盘不生效" -->
                    <StackPanel x:Name="KeyboardSection">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T '键盘设备'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{loc:T '只列出系统认到的键盘，不改任何按键行为。复合键盘常被系统拆成多条，这里已按物理设备归并。'}"
                                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:T '刷新'}" Padding="12,5" VerticalAlignment="Top"
                                    Style="{StaticResource Button.Base}" Click="OnRefreshKeyboardsClick" />
                        </Grid>
                        <TextBlock x:Name="KeyboardEmptyText" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,8,0,0" Visibility="Collapsed"
                                   Text="{loc:T '没有枚举到键盘设备。'}" />
                        <TextBlock x:Name="DeviceTrackingHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource Brush.Danger}" />
                        <ItemsControl x:Name="KeyboardList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 权限：普通权限下对着管理员程序按快捷键会静默失效，所以要显眼 -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T '以管理员身份启动'}" Style="{StaticResource Text.Body}" />
                                    <Border x:Name="AdminBadge" Margin="8,0,0,0" Padding="7,1"
                                            CornerRadius="5" Background="{DynamicResource Brush.WarningSoft}"
                                            BorderBrush="{DynamicResource Brush.WarningBorder}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminBadgeText" Text="{loc:T '管理员'}" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PermissionText" Style="{StaticResource Text.Tertiary}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!--
                                提权开关。
                                ⚠ 切到管理员后，「选中文字 → 直接搜索」会失效 ——
                                管理员进程无法向普通权限的浏览器 / 编辑器注入输入
                                （Windows 的 UIPI 限制）。所以默认关闭。
                            -->
                            <CheckBox Grid.Column="1" x:Name="RunAsAdminBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnRunAsAdminChanged"
                                      ToolTip="{loc:T '开启后下次启动会弹一次 UAC 确认；关闭则一直以普通权限运行'}" />
                        </Grid>

                        <!--
                            状态行：把"设置成什么"和"现在实际是什么"分开显示。
                            两者不一致时给一个「立即重启」按钮 ——
                            否则用户改完开关以为已经生效，实际上要等下次启动，
                            中间会一直以为功能坏了。
                        -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AdminStateText" Grid.Column="0"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RestartElevatedButton" Grid.Column="1"
                                    Style="{StaticResource Button.Base}" Padding="12,5"
                                    Content="{loc:T '立即重启以生效'}" Visibility="Collapsed"
                                    Click="OnRestartForElevation" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!--
                        启动密码：和「同步与备份」页的备份密码完全是两回事。
                        那一个给备份文件和本地数据加密；这一个只卡启动 ——
                        用户点名要求分开，所以字段、校验、入口全都独立。
                    -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:T '启动密码保护'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{loc:T '每次启动软件时先要求输入密码，正确才进入主界面'}"
                                           Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="StartupPwBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnStartupPasswordChanged"
                                      ToolTip="{loc:T '开启时需要先设置一个新密码；关闭时需要验证当前密码'}" />
                        </Grid>

                        <!-- 状态行 + 修改密码按钮（设了才显示） -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartupPwStateText" Grid.Column="0"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ChangeStartupPwButton" Grid.Column="1"
                                    Style="{StaticResource Button.Base}" Padding="12,5"
                                    Content="{loc:T '修改密码'}" Visibility="Collapsed"
                                    Click="OnChangeStartupPassword" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '更新完成后弹提示'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '自动更新装上新版后，在屏幕角落提示一句「已更新到 x.x.x」'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="UpdateToastBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnUpdateToastChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '显示按键反馈'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '每次组合键生效时在屏幕角落闪一下功能名，用来确认按键有没有被识别'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="FeedbackBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnFeedbackChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '按键行为'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '短按 CapsLock'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '不按其他键、直接松开 Caps 时的行为'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="TapCapsBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnTapCapsChanged">
                            <ComboBoxItem Content="{loc:T '切换大小写（默认）'}" Tag="toggleCapsLock" />
                            <ComboBoxItem Content="{loc:T '发送 Esc'}" Tag="esc" />
                            <ComboBoxItem Content="{loc:T '什么都不做'}" Tag="doNothing" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '输入文本方式'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '「输入文本」怎么把文字打进光标处。默认「自动」：长文本走剪贴板粘贴（粘完把剪贴板还原），短文本英文走真实按键（密码框也认）、中文走 Unicode 注入；中文输入法开着时会临时切到英文输入，打完自动切回。密码框仍打不进时改选「真实按键」（此时长文本也逐字敲，可能被程序吞字）。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="TextInputBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnTextInputModeChanged">
                            <ComboBoxItem Content="{loc:T '自动（推荐）'}" Tag="auto" />
                            <ComboBoxItem Content="{loc:T '真实按键'}" Tag="keys" />
                            <ComboBoxItem Content="{loc:T 'Unicode 注入'}" Tag="unicode" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '双击 CapsLock 打开 Qbar'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '快速双击 Caps（420 毫秒内）直接打开搜索面板'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="DoubleTapBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnDoubleTapChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '按住组合键时连续触发'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按住 Caps+S 不松手可以一直向左移动光标'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="RepeatBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnRepeatChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '鼠标移动速度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="MouseSpeedText" Text="{loc:T '3（Caps+LAlt+滚轮 可快速调整）'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="MouseSpeedSlider" Width="180" Minimum="1" Maximum="20"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnMouseSpeedChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '音量调节幅度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="VolumeStepText" Text="5%"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="VolumeStepSlider" Width="180" Minimum="1" Maximum="20"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnVolumeStepChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '亮度调节幅度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="BrightnessStepText" Text="10%"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="BrightnessStepSlider" Width="180" Minimum="1" Maximum="50"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnBrightnessStepChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '外观'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '主题'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '跟随系统会随 Windows 的深浅色设置自动切换'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="{loc:T '浅色'}" Tag="light" />
                            <ComboBoxItem Content="{loc:T '深色'}" Tag="dark" />
                            <ComboBoxItem Content="{loc:T '跟随系统'}" Tag="system" />
                        </ComboBox>
                    </Grid>

                    <!-- 界面语言：条目来自内置语言包（Assets/Lang/*.json），
                         丢一个新 json 进来就会自动出现在这个下拉里，不用改代码。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '界面语言'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '切换后立即生效，不用重启'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnLanguageChanged">
                            <!-- 用 ItemTemplate 而不是 DisplayMemberPath：
                                 胶囊里显示的是 ComboBox 的 SelectionBoxItem，
                                 这条路径对 DisplayMemberPath 的处理不可靠 ——
                                 v4.5.26 就在这里显示成 `LocLanguage { Code …`。
                                 明细模板两条路（胶囊 + 下拉项）都会走，最稳。 -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:T '数据与维护'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="0,6,0,14" />
                    <WrapPanel>
                        <Button Content="{loc:T '从旧版 CapsLock+ 导入设置'}" Style="{StaticResource Button.Base}"
                                Margin="0,0,8,8" Click="OnImportLegacy" />
                        <Button Content="{loc:T '打开设置文件'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnOpenSettingsFile" />
                        <Button Content="{loc:T '打开日志'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnOpenLog" />
                        <Button Content="{loc:T '重新加载配置'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnReload" />
                        <Button Content="{loc:T '重置全部设置'}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"
                                Click="OnResetAll" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
