<UserControl x:Class="CapsLockPlus.UI.Views.TranslateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
            <StackPanel>
                <TextBlock Text="翻译" Style="{StaticResource Text.H2}" />
                <TextBlock Text="选中文本后按 Caps+F3，弹窗会显示译文，可一键替换原文或复制。"
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,16" />

                <TextBlock Text="翻译服务" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                <ComboBox x:Name="ProviderBox" Style="{StaticResource ComboBox.Base}" SelectionChanged="OnProviderChanged" />

                <StackPanel x:Name="KeyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="KeyIdLabel" Text="应用 ID" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                    <TextBox x:Name="AppIdBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnCredentialChanged" />
                    <TextBlock x:Name="KeySecretLabel" Text="应用密钥" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                    <!-- 必须用 TextBox.Base：WPF 默认 PasswordBox 是白底方角，
                         在深色主题下会变成一块刺眼的白板，也破坏整体风格。 -->
                    <PasswordBox x:Name="AppSecretBox" Style="{StaticResource PasswordBox.Base}"
                                 MinHeight="36" PasswordChanged="OnSecretChanged" />
                    <TextBlock x:Name="KeyHint" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <TextBlock Text="目标语言" Style="{StaticResource Text.Secondary}" Margin="0,16,0,6" />
                <ComboBox x:Name="TargetBox" Style="{StaticResource ComboBox.Base}" SelectionChanged="OnTargetChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-CHS" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                    <ComboBoxItem Content="한국어" Tag="ko" />
                </ComboBox>

                <Button Content="保存并试译一段文字" Style="{StaticResource Button.Primary}" Margin="0,18,0,0"
                        Click="OnTryClick" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
            <StackPanel>
                <TextBlock Text="怎么用" Style="{StaticResource Text.H3}" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="1. 在任意程序里选中一段文字&#x0a;2. 按 Caps+F3&#x0a;3. 弹窗里点「替换原文」或「复制译文」" />
                <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />
                <TextBlock Text="也可以在这里手动输入" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                <TextBox x:Name="InputBox" Style="{StaticResource TextBox.Base}" MinHeight="90" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                <Button Content="翻译" Style="{StaticResource Button.Base}" Margin="0,10,0,0"
                        Click="OnTranslateHere" HorizontalAlignment="Left" />
                <Border Style="{StaticResource Card.Flat}" Margin="0,14,0,0" Padding="12">
                    <TextBlock x:Name="ResultText" Text="（译文会显示在这里）" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
