<UserControl x:Class="CapsLockPlus.UI.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapsLockPlus.UI.Markup;assembly=CapsLockPlus.Localization"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T '两个互不干扰的剪贴板'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T 'Caps+C / V 用剪贴板 1，Caps+LAlt+C / V 用剪贴板 2，不会覆盖系统剪贴板里的内容。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="EnableBox" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Click="OnToggleEnabled" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="{loc:T '剪贴板 1'}" Style="{StaticResource Text.H3}" />
                    <TextBlock x:Name="Slot1Text" Text="{loc:T '（空）'}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="120" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:T '粘贴'}" Style="{StaticResource Button.Primary}" Padding="12,5"
                                Click="OnPaste1" />
                        <Button Content="{loc:T '清空'}" Style="{StaticResource Button.Ghost}" Padding="12,5"
                                Margin="6,0,0,0" Click="OnClear1" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T '剪贴板 2'}" Style="{StaticResource Text.H3}" />
                    <TextBlock x:Name="Slot2Text" Text="{loc:T '（空）'}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="120" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:T '粘贴'}" Style="{StaticResource Button.Primary}" Padding="12,5"
                                Click="OnPaste2" />
                        <Button Content="{loc:T '清空'}" Style="{StaticResource Button.Ghost}" Padding="12,5"
                                Margin="6,0,0,0" Click="OnClear2" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="{loc:T '最近复制'}" Style="{StaticResource Text.H3}" />
                    <Button Content="{loc:T '清空历史'}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                            Click="OnClearHistory" />
                </Grid>
                <ListBox Grid.Row="1" x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}" Margin="0,10,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnHistoryDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
