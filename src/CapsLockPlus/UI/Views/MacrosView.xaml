<UserControl x:Class="CapsLockPlus.UI.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- 左：宏列表 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="宏" Style="{StaticResource Text.H2}" />
                <TextBlock Grid.Row="0" Style="{StaticResource Text.Tertiary}" Margin="0,4,0,12"
                           Text="录一段操作，绑到任意按键上。支持在字符之间插入固定或随机延迟。" />

                <ListBox Grid.Row="1" x:Name="MacroList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnMacroSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                           Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="＋ 新建" Style="{StaticResource Button.Primary}" Click="OnNewClick" />
                    <Button Content="删除" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                            Click="OnDeleteClick" />
                    <Button Content="测试播放" Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                            Click="OnTestClick" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：录制 + 步骤编辑 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 录制 -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="录制" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Text="点「开始录制」后照常操作键盘，按键之间的间隔会被自动记下来。&#x0a;再点「停止录制」生成宏。录制期间不影响正常输入。" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecordButton" Content="开始录制" Style="{StaticResource Button.Primary}"
                                    Click="OnRecordClick" />
                            <TextBlock x:Name="RecordStatus" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 步骤编辑 -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="步骤" Style="{StaticResource Text.H3}" />

                        <TextBlock Text="名称" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnNameChanged" />

                        <TextBlock Text="重复次数（0 = 一直循环）" Style="{StaticResource Text.Secondary}"
                                   Margin="0,12,0,6" />
                        <TextBox x:Name="RepeatBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnRepeatChanged" />

                        <TextBlock Text="步骤列表" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="点一行选中它，下面的插入会插到它后面。延迟可以随时改数值。" />
                        <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0" MaxHeight="240"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnStepSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Order}" Width="26"
                                                   Style="{StaticResource Text.Tertiary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="&#xE711;"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="9" Style="{StaticResource Button.Ghost}"
                                                Padding="8,4" Tag="{Binding Index}" Click="OnRemoveStep" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 选中步骤的编辑区 -->
                        <Border x:Name="StepEditor" Margin="0,10,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="StepEditorTitle" Style="{StaticResource Text.Secondary}"
                                           Margin="0,0,0,6" />

                                <!-- 固定延迟 -->
                                <StackPanel x:Name="DelayEditPanel" Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <TextBlock Text="等待" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Secondary}" />
                                    <TextBox x:Name="DelayEditBox" Width="90" Margin="8,0,8,0"
                                             Style="{StaticResource TextBox.Base}" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnDelayEditChanged" />
                                    <TextBlock Text="毫秒" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Secondary}" />
                                </StackPanel>

                                <!-- 随机延迟 -->
                                <StackPanel x:Name="RandomEditPanel" Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <TextBlock Text="随机" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Secondary}" />
                                    <TextBox x:Name="MinEditBox" Width="72" Margin="8,0,6,0"
                                             Style="{StaticResource TextBox.Base}" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnRandomEditChanged" />
                                    <TextBlock Text="~" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Secondary}" />
                                    <TextBox x:Name="MaxEditBox" Width="72" Margin="6,0,8,0"
                                             Style="{StaticResource TextBox.Base}" MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnRandomEditChanged" />
                                    <TextBlock Text="毫秒（每次播放随机取）" VerticalAlignment="Center"
                                               Style="{StaticResource Text.Secondary}" />
                                </StackPanel>

                                <!-- 文本 -->
                                <StackPanel x:Name="TextEditPanel" Visibility="Collapsed">
                                    <TextBox x:Name="TextEditBox" Style="{StaticResource TextBox.Base}"
                                             MinHeight="34" VerticalContentAlignment="Center"
                                             TextChanged="OnTextEditChanged" />
                                </StackPanel>

                                <!-- 按键：允许换成别的键 -->
                                <StackPanel x:Name="KeyEditPanel" Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <Border Style="{StaticResource Keycap}" Padding="10,6">
                                        <TextBlock x:Name="KeyEditLabel" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <Button Content="换成别的键…" Style="{StaticResource Button.Base}"
                                            Padding="12,6" Margin="10,0,0,0" Click="OnChangeStepKey" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 插入步骤 -->
                        <TextBlock x:Name="InsertHint" Text="插入（追加到末尾）"
                                   Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                        <WrapPanel>
                            <Button Content="延迟(毫秒)" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnInsertDelay" />
                            <Button Content="随机延迟" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnInsertRandom" />
                            <Button Content="文本" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnInsertText" />
                            <Button Content="按键 按下" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnInsertKeyDown" />
                            <Button Content="按键 抬起" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnInsertKeyUp" />
                        </WrapPanel>

                        <TextBlock Text="提示：想在某两个字之间加停顿，就先选中它前面那一步，再点「延迟」。"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 绑定说明 -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="怎么用" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="到「按键映射」页选一个按键，在“功能”下拉里选「宏」分类下的「播放宏：xxx」即可绑定。&#x0a;参数栏填数字可以临时覆盖重复次数。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
