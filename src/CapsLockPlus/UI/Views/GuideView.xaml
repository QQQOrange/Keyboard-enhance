<UserControl x:Class="CapsLockPlus.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,4,20,24">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <!-- 欢迎横幅 -->
            <Border CornerRadius="18" Padding="26,24" Margin="0,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B6CF6" Offset="0" />
                        <GradientStop Color="#5B5BF0" Offset="0.55" />
                        <GradientStop Color="#22C1E8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="让每一个按键，都能变成你的快捷键" FontSize="24" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="按住触发键就是功能键：字母键移动 / 选择光标，数字键切换窗口，Q 打开搜索面板。"
                                   Foreground="#E4EDFF" FontSize="13.5" Margin="0,9,0,0" TextWrapping="Wrap"
                                   MaxWidth="620" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="开始 3 步设置" Style="{StaticResource Button.Base}"
                                    Background="White" BorderBrush="White" Foreground="#1D4ED8"
                                    FontWeight="SemiBold" Padding="18,8" Click="OnStartSetup" />
                            <Button Content="查看快捷键速查" Style="{StaticResource Button.Base}"
                                    Background="#33FFFFFF" BorderBrush="#55FFFFFF" Foreground="White"
                                    Padding="16,8" Margin="10,0,0,0" Click="OnOpenHelp" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Style="{StaticResource Keycap}" Background="#FFFFFF" Padding="14,10">
                            <TextBlock Text="Caps" FontWeight="SemiBold" FontSize="15" Foreground="#1D4ED8" />
                        </Border>
                        <TextBlock Text="+" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <Border Style="{StaticResource Keycap}" Background="#FFFFFF" Padding="14,10">
                            <TextBlock Text="Q" FontWeight="SemiBold" FontSize="15" Foreground="#1D4ED8" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 状态卡片 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="运行状态" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="RunStateText" Text="已启用" Style="{StaticResource Text.H2}" Margin="0,12,0,0" />
                        <TextBlock x:Name="RunStateHint" Text="按住触发键即可使用全部功能"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="按键方案" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SchemeText" Text="Capslox（推荐）" Style="{StaticResource Text.H2}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="可以在「按键映射」里逐项修改" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="开机自启" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StartupText" Text="未开启" Style="{StaticResource Text.H2}" Margin="0,12,0,0" />
                        <TextBlock Text="建议开启，开机即可使用" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 三步上手 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="三步就能用起来" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="不用记命令，也不用改配置文件。" Style="{StaticResource Text.Secondary}"
                               Margin="0,4,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Accent}">
                                    <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="试一下组合键" Style="{StaticResource Text.H3}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="按住触发键再按 S / D / E / F，光标会按字符移动；配合 H / J / K / L 是选择。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Accent}">
                                    <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="打开 Qbar" Style="{StaticResource Text.H3}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="按 Caps+Q：输入程序名直接回车启动，输入关键词回车搜索，输入 =1+2*3 直接算结果。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Accent}">
                                    <TextBlock Text="3" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="按自己的习惯改" Style="{StaticResource Text.H3}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="「按键映射」里点任意一项即可换成别的功能，改完立刻生效，不用重启。"
                                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 常用组合 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="最常用的 8 个组合" Style="{StaticResource Text.H2}" />
                        <Button Content="全部快捷键" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                                Click="OnOpenHelp" />
                    </Grid>
                    <ItemsControl x:Name="QuickKeys" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" Padding="12,10" CornerRadius="10"
                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Keycap}">
                                                <TextBlock Text="Caps" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </Border>
                                            <Border Style="{StaticResource Keycap}">
                                                <TextBlock Text="{Binding Key}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding Desc}" Style="{StaticResource Text.Tertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
