<UserControl x:Class="CapsLockPlus.UI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：WebDAV 同步 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="WebDAV 同步" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="把配置备份到网盘（坚果云等）。启动同步、退出同步、自动备份是三个独立开关，可以同时打开。" />

                    <TextBlock Text="服务器地址" Style="{StaticResource Text.Secondary}" Margin="0,16,0,6" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnUrlChanged" />
                    <TextBlock Text="例：https://dav.jianguoyun.com/dav/　（只填到 dav/ 即可；软件会在里面建一个 KeyboardEnhance/ 子目录，点「测连接」时如果还没有会当场建好）"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="用户名" Style="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6" />
                            <TextBox x:Name="UserBox" Style="{StaticResource TextBox.Base}"
                                     MinHeight="36" VerticalContentAlignment="Center"
                                     TextChanged="OnUserChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码" Style="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6" />
                            <PasswordBox x:Name="PassBox" Style="{StaticResource PasswordBox.Base}"
                                         PasswordChanged="OnPassChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="坚果云要用「应用密码」，不是登录密码"
                               Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0" />

                    <TextBlock Text="备份密码（加密用）" Style="{StaticResource Text.Secondary}"
                               Margin="0,14,0,6" />
                    <PasswordBox x:Name="BackupPassBox" Style="{StaticResource PasswordBox.Base}"
                                 PasswordChanged="OnBackupPassChanged" />
                    <Border x:Name="NoPasswordWarning" Margin="0,8,0,0" Padding="10,7" CornerRadius="8"
                            Background="#22E5484D" BorderBrush="#55E5484D" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="#E5484D"
                                   Text="没设备份密码 —— 现在不能备份。备份和本地数据都必须加密，设一个密码就能用。" />
                    </Border>

                    <!-- 本地加密状态：设了密码之后磁盘上就不再留明文用户数据 -->
                    <Border x:Name="VaultStatusBar" Margin="0,8,0,0" Padding="10,7" CornerRadius="8"
                            Background="#221D9E75" BorderBrush="#551D9E75" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="VaultStatusText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#0F6E56" />
                    </Border>

                    <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="启动时同步" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="比云端与本机哪份新，谁新用谁"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="OnStartBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnOnStartChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="退出时同步" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="退出前把当前配置推上去（最多等 8 秒）"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="OnExitBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnOnExitChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                    <WrapPanel>
                        <Button Content="测连接" Style="{StaticResource Button.Base}" Padding="14,7"
                                Margin="0,0,8,8" Click="OnTestClick" />
                        <Button Content="立即备份并上传" Style="{StaticResource Button.Primary}" Padding="14,7"
                                Margin="0,0,8,8" Click="OnUploadClick" />
                        <Button Content="从备份恢复…" Style="{StaticResource Button.Base}" Padding="14,7"
                                Margin="0,0,8,8" Click="OnRestoreClick" />
                    </WrapPanel>

                    <TextBlock x:Name="SyncStatus" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 右：本地备份 / 导出 / 导入 -->
            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                <Border Style="{StaticResource Card}" Padding="18,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="本地备份" Style="{StaticResource Text.H2}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="备份就放在软件旁边的「KeyboardEnhance Back」文件夹里，拷走整个文件夹就带走了软件和全部备份。" />

                        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="BackupDirText" Style="{StaticResource Text.Mono}"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock x:Name="FallbackHint" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#E5484D"
                                           Visibility="Collapsed"
                                           Text="软件目录不可写，备份已改放到数据目录。" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="用户数据目录" Style="{StaticResource Text.Tertiary}"
                                           FontSize="11" />
                                <TextBlock x:Name="DataDirText" Style="{StaticResource Text.Mono}"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock x:Name="DataEncText" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="打开备份目录" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnOpenBackupDir" />
                            <Button Content="打开配置目录" Style="{StaticResource Button.Base}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnOpenDataDir" />
                            <Button Content="现在就备份一次" Style="{StaticResource Button.Ghost}" Padding="12,6"
                                    Margin="0,0,8,8" Click="OnLocalBackupClick" />
                        </WrapPanel>

                        <TextBlock x:Name="LocalSummary" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                        <TextBlock Text="保留策略" Style="{StaticResource Text.Secondary}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="本地和云端用同一套规则；最新那份永远保留，不会因为超期被删光。" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="只保留最近" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="KeepBox" Style="{StaticResource TextBox.Base}"
                                     Width="60" MinHeight="30" Margin="8,0,0,0" Padding="8,0"
                                     VerticalContentAlignment="Center" LostFocus="OnKeepChanged" />
                            <TextBlock Text="份" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />

                            <TextBlock Text="清掉" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <TextBox x:Name="DaysBox" Style="{StaticResource TextBox.Base}"
                                     Width="60" MinHeight="30" Margin="8,0,0,0" Padding="8,0"
                                     VerticalContentAlignment="Center" LostFocus="OnDaysChanged" />
                            <TextBlock Text="天前的（0 = 不按天数清）" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="自动备份" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="按间隔自动打包一份；配置没变化就跳过"
                                           Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="AutoBackupBox"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnAutoBackupChanged" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="间隔" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="AutoMinutesBox" Style="{StaticResource TextBox.Base}"
                                     Width="60" MinHeight="30" Margin="8,0,0,0" Padding="8,0"
                                     VerticalContentAlignment="Center" LostFocus="OnAutoMinutesChanged" />
                            <TextBlock Text="分钟" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="导出配置" Style="{StaticResource Text.H2}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="勾了哪一组，就导出那一组的**全部内容**。默认加密导出，文件本身是密文；只有关掉加密时才会剔除密码类字段（那种文件可以直接发给别人）。" />

                        <!-- 导出模式 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="加密导出" Style="{StaticResource Text.Body}" />
                                <TextBlock x:Name="ExportModeHint" Style="{StaticResource Text.Tertiary}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="用备份密码加密，含网盘密码 / 备份密码 / 翻译密钥等全部字段。换台机器导入时输入同一个密码即可。" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ExportEncryptedBox"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="True" VerticalAlignment="Center"
                                      Click="OnExportModeChanged" />
                        </Grid>

                        <ItemsControl x:Name="GroupList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="10"
                                            Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Checked}"
                                                      VerticalAlignment="Center" Tag="{Binding Id}"
                                                      Click="OnGroupToggled" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <!-- 隐私标记：红色 -->
                                                    <Border Margin="8,0,0,0" Padding="6,1"
                                                            CornerRadius="5" Background="#22E5484D"
                                                            BorderBrush="#55E5484D" BorderThickness="1"
                                                            Visibility="{Binding PrivateVisibility}">
                                                        <TextBlock Text="隐私 · 默认不勾" FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E5484D" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Desc}"
                                                           Style="{StaticResource Text.Tertiary}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="全不选" Style="{StaticResource Button.Ghost}" Padding="12,6"
                                    Click="OnSelectNone" />
                            <Button Content="只选非隐私" Style="{StaticResource Button.Ghost}" Padding="12,6"
                                    Margin="8,0,0,0" Click="OnSelectSafe" />
                            <Button Content="全选" Style="{StaticResource Button.Ghost}" Padding="12,6"
                                    Margin="8,0,0,0" Click="OnSelectAll" />
                        </StackPanel>

                        <Button Content="导出到文件…" Style="{StaticResource Button.Primary}" Padding="16,8"
                                Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnExportClick" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="导入配置" Style="{StaticResource Text.H2}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="加密导出和明文导出都能导入（加密的会问你要密码）。&#x0a;导入是合并式的：只覆盖导出文件里包含的那些项。" />

                        <Button Content="选择文件导入…" Style="{StaticResource Button.Base}" Padding="16,8"
                                Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnImportClick" />

                        <Border x:Name="ImportResult" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ImportResultText" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
