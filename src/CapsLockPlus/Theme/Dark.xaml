<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题调色板 -->
    <Color x:Key="Color.Background">#0F1218</Color>
    <Color x:Key="Color.BackgroundAlt">#141821</Color>
    <Color x:Key="Color.Surface">#1A1E27</Color>
    <Color x:Key="Color.SurfaceAlt">#20252F</Color>
    <Color x:Key="Color.Sidebar">#141821</Color>
    <Color x:Key="Color.Border">#2A3040</Color>
    <Color x:Key="Color.BorderStrong">#394154</Color>
    <Color x:Key="Color.TextPrimary">#EDF1F8</Color>
    <Color x:Key="Color.TextSecondary">#A6B0C3</Color>
    <Color x:Key="Color.TextTertiary">#727D91</Color>
    <Color x:Key="Color.Accent">#5B93FF</Color>
    <Color x:Key="Color.AccentHover">#79A7FF</Color>
    <Color x:Key="Color.AccentSoft">#1C2942</Color>
    <Color x:Key="Color.AccentSoftBorder">#2C4370</Color>
    <Color x:Key="Color.Hover">#232936</Color>
    <Color x:Key="Color.Selected">#1E2C46</Color>
    <Color x:Key="Color.Danger">#FF6369</Color>
    <Color x:Key="Color.Success">#3DD68C</Color>
    <Color x:Key="Color.Warning">#F5A524</Color>
    <Color x:Key="Color.Keycap">#232935</Color>
    <Color x:Key="Color.KeycapBorder">#333B4D</Color>
    <Color x:Key="Color.KeycapShadow">#0B0D12</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.BackgroundAlt" Color="{DynamicResource Color.BackgroundAlt}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="{DynamicResource Color.AccentSoftBorder}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{DynamicResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.QbarRowHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.QbarRowSelected" Color="#2E5B93FF" />
    <SolidColorBrush x:Key="Brush.Keycap" Color="{DynamicResource Color.Keycap}" />
    <SolidColorBrush x:Key="Brush.KeycapBorder" Color="{DynamicResource Color.KeycapBorder}" />
    <SolidColorBrush x:Key="Brush.KeycapShadow" Color="{DynamicResource Color.KeycapShadow}" />

    <LinearGradientBrush x:Key="Brush.WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#11151C" Offset="0" />
        <GradientStop Color="#0E1118" Offset="0.55" />
        <GradientStop Color="#121826" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B93FF" Offset="0" />
        <GradientStop Color="#8B6CFF" Offset="0.6" />
        <GradientStop Color="#3EE0F0" Offset="1" />
    </LinearGradientBrush>

    <!-- ================= 浮层（Qbar / 提示条 / 录制条 / 选窗口） =================
         这几个窗口是"浮在别的内容上"的，所以有自己的底色体系：
         底色比普通面板更深、边框靠一点透明白、强调色更亮。

         以前这套颜色是**在 4 个 XAML 里各写一遍**（#F21C1F27 / #F2161A23 /
         #F2F5FA / #9FB4D8 …），深浅两套主题下都不跟随 —— 浅色主题里
         突然弹出一块深色板。现在统一由主题提供，浮层只引用键名。 -->
    <SolidColorBrush x:Key="Brush.OverlayCard" Color="#F21C1F27" />
    <SolidColorBrush x:Key="Brush.OverlayCardAlt" Color="#F2161A23" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayBorderAccent" Color="#335B93FF" />
    <SolidColorBrush x:Key="Brush.OverlayText" Color="#F2F5FA" />
    <SolidColorBrush x:Key="Brush.OverlayTextSecondary" Color="#9FB4D8" />
    <SolidColorBrush x:Key="Brush.OverlayTextTertiary" Color="#6E7F99" />
    <SolidColorBrush x:Key="Brush.OverlayAccent" Color="#5B93FF" />
    <SolidColorBrush x:Key="Brush.OverlayAccentSoft" Color="#2E5B93FF" />
    <SolidColorBrush x:Key="Brush.OverlayAccentText" Color="#8FB6FF" />
    <SolidColorBrush x:Key="Brush.OverlayRowHover" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayScrim" Color="#33000000" />
    <SolidColorBrush x:Key="Brush.OverlayShadow" Color="#1A000000" />

    <!-- 语义色的"柔和底 + 描边"：用于提示条、危险操作区。
         以前这些值直接写死在 BackupView 里（#22E5484D / #221D9E75 …），
         文字色也是硬编码的浅色红绿 —— 深色主题下那几块几乎看不清。 -->
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#22FF6369" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#55FF6369" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#223DD68C" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#553DD68C" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#22F5A524" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#55F5A524" />
</ResourceDictionary>
