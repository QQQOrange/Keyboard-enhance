<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题调色板 -->
    <Color x:Key="Color.Background">#F2F5FA</Color>
    <Color x:Key="Color.BackgroundAlt">#E9EEF7</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F5F8FC</Color>
    <Color x:Key="Color.Sidebar">#FBFCFE</Color>
    <Color x:Key="Color.Border">#E4E8F0</Color>
    <Color x:Key="Color.BorderStrong">#D3D9E6</Color>
    <Color x:Key="Color.TextPrimary">#161A23</Color>
    <Color x:Key="Color.TextSecondary">#5B6478</Color>
    <Color x:Key="Color.TextTertiary">#8A93A6</Color>
    <Color x:Key="Color.Accent">#2B6CF6</Color>
    <Color x:Key="Color.AccentHover">#1F5BE0</Color>
    <Color x:Key="Color.AccentSoft">#E8F0FF</Color>
    <Color x:Key="Color.AccentSoftBorder">#C7DAFF</Color>
    <Color x:Key="Color.Hover">#F0F3F9</Color>
    <Color x:Key="Color.Selected">#E8F0FF</Color>
    <Color x:Key="Color.Danger">#E5484D</Color>
    <Color x:Key="Color.Success">#1F9D62</Color>
    <Color x:Key="Color.Warning">#D9822B</Color>
    <Color x:Key="Color.Keycap">#FFFFFF</Color>
    <Color x:Key="Color.KeycapBorder">#DCE2EE</Color>
    <Color x:Key="Color.KeycapShadow">#C9D2E3</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.BackgroundAlt" Color="{DynamicResource Color.BackgroundAlt}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="{DynamicResource Color.AccentSoftBorder}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{DynamicResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.QbarRowHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Brush.QbarRowSelected" Color="#1F2B6CF6" />
    <SolidColorBrush x:Key="Brush.Keycap" Color="{DynamicResource Color.Keycap}" />
    <SolidColorBrush x:Key="Brush.KeycapBorder" Color="{DynamicResource Color.KeycapBorder}" />
    <SolidColorBrush x:Key="Brush.KeycapShadow" Color="{DynamicResource Color.KeycapShadow}" />

    <!-- 渐变背景（窗口/侧栏） -->
    <LinearGradientBrush x:Key="Brush.WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FAFF" Offset="0" />
        <GradientStop Color="#EFF4FB" Offset="0.5" />
        <GradientStop Color="#E8EFF9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B6CF6" Offset="0" />
        <GradientStop Color="#6C4CF6" Offset="0.6" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <!-- ================= 浮层（Qbar / 提示条 / 录制条 / 选窗口） =================
         浅色主题下浮层是"半透明白 + 深色字"，和 Windows 通知中心同一套观感；
         以前这里写死深色，浅色主题下弹出一块黑板（审视报告 P2-2）。 -->
    <SolidColorBrush x:Key="Brush.OverlayCard" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayCardAlt" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="Brush.OverlayBorderAccent" Color="#332B6CF6" />
    <SolidColorBrush x:Key="Brush.OverlayText" Color="#161A23" />
    <SolidColorBrush x:Key="Brush.OverlayTextSecondary" Color="#5A6478" />
    <SolidColorBrush x:Key="Brush.OverlayTextTertiary" Color="#8A93A6" />
    <SolidColorBrush x:Key="Brush.OverlayAccent" Color="#2B6CF6" />
    <SolidColorBrush x:Key="Brush.OverlayAccentSoft" Color="#1F2B6CF6" />
    <SolidColorBrush x:Key="Brush.OverlayAccentText" Color="#2B6CF6" />
    <SolidColorBrush x:Key="Brush.OverlayRowHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Brush.OverlayScrim" Color="#22000000" />
    <SolidColorBrush x:Key="Brush.OverlayShadow" Color="#26000000" />

    <!-- 语义色的"柔和底 + 描边"，见 Dark.xaml 同名说明。 -->
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#14E5484D" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#44E5484D" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#141F9D62" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#441F9D62" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#14D9822B" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#44D9822B" />
</ResourceDictionary>
