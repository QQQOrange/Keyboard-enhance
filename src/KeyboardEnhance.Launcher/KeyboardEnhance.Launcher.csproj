<Project Sdk="Microsoft.NET.Sdk">

  <!--
    启动器（引导程序）。

    为什么需要它：主程序是**依赖 .NET 10 运行时**的单文件应用，
    机器上没装 .NET 10 时，系统的 apphost 只会静默失败或弹一个英文框 ——
    用户看到的就是"双击没反应"。而 .NET 程序在缺运行时时根本跑不起来，
    所以必须在 .NET 之前拦一道：这就是本启动器的全部职责。

    为什么用 net48：Windows 10 1803+ 自带 .NET Framework 4.7.2 以上，
    4.8 在 1903+ 是系统组件。也就是说这个 exe **在任何目标机器上都能跑**，
    而且不引用任何第三方包，产物只有几 KB。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KeyboardEnhance</AssemblyName>
    <RootNamespace>KeyboardEnhance.Launcher</RootNamespace>
    <ApplicationIcon>..\CapsLockPlus\Assets\app.ico</ApplicationIcon>
    <Product>按键增强 Keyboard Enhance</Product>
    <Company>QQQOrange</Company>
    <AssemblyTitle>按键增强 启动器</AssemblyTitle>
    <Description>检查 .NET 10 桌面运行时；缺了就提示并打开下载页面，有就直接启动主程序</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 不生成 app.config / deps 之类多余文件，只要一个 exe -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

</Project>
